{# Check if the form as a whole (global errors) or any of its fields have errors #}
{% if not form.vars.valid %}
    <div class="apple-alert apple-alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-octagon-fill fs-4 mt-1 me-2 flex-shrink-0"></i>
        <div class="flex-grow-1">
            <h6 class="fw-bold mb-1">Por favor corrige los siguientes errores:</h6>
            <ul class="list-unstyled mb-0 small">
                {# 1. Display GLOBAL Errors from controller in ->addError #}
                {% for error in form.vars.errors %}
                    <li><i class="bi bi-dot me-1"></i>{{ error.message }}</li>
                {% endfor %}

                {# -------------------------------------------------------------------------- #}
                {# 2. Display FIELD-SPECIFIC Errors (Access messages directly, not form_errors) #}
                {# -------------------------------------------------------------------------- #}
                {% for child in form.children %}
                    {% for error in child.vars.errors %}
                        <li>
                            <i class="bi bi-dot me-1"></i><strong>{{ child.vars.label|default(child.vars.name)|capitalize }}:</strong>
                            {{ error.message }}
                        </li>
                    {% endfor %}
                {% endfor %}
                {# -------------------------------------------------------------------------- #}
            </ul>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
{% endif %}
