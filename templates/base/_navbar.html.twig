<nav class="app-header navbar navbar-expand apple-topbar" id="navigation" tabindex="-1">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Start Navbar Links-->
        <ul class="navbar-nav" role="navigation" aria-label="Navigation 1">
            <li class="nav-item d-flex align-items-center">
                <a class="apple-sidebar-toggle-btn shadow-sm" 
                   data-lte-toggle="sidebar" 
                   data-controller="apple-spring"
                   href="#" 
                   role="button" 
                   aria-label="Alternar barra lateral"
                   title="Menú lateral">
                    <i class="bi bi-list"></i>
                </a>
            </li>
        </ul>
        <!--end::Start Navbar Links-->

        <!--begin::End Navbar Links-->
        <ul class="navbar-nav ms-auto align-items-center" role="navigation" aria-label="Navigation 2">
            <!--begin::Theme Toggle Button-->
            <li class="nav-item d-flex align-items-center me-2">
                <button type="button" 
                        class="apple-theme-toggle-btn shadow-sm"
                        data-controller="apple-spring theme-toggle"
                        data-action="click->theme-toggle#toggle"
                        data-theme-toggle-btn
                        aria-label="Alternar modo oscuro o claro"
                        title="Alternar tema">
                    <i class="bi bi-sun-fill text-warning" data-theme-icon></i>
                </button>
            </li>
            <!--end::Theme Toggle Button-->

            <!--begin::User Menu Dropdown-->
            {# Define variables at the start for cleanliness #}
            {% set display_name = app.user.displayName %}
            {% set role_label = app.user|primary_role_label %}
            {% set role_icon = app.user|primary_role_icon %}

            {# Define avatar url #}
            {% if app.user.avatarUrl is empty %}
                {% set final_src = asset('build/assets/img/user2-160x160.jpg') %}
                {% set original_src = asset('build/assets/img/user2-160x160.jpg') %}
            {% elseif app.user.avatarUrl starts with 'http' %}
                {# It is a Google/External URL, leave this trash as it is #}
                {% set final_src = app.user.avatarUrl %}
                {% set original_src = app.user.avatarUrl %}
            {% else %}
                {# It is a Local File, apply filters and services  #}
                {% set full_photo_path = paciente_photo_path ~ app.user.avatarUrl %}
                {% set final_src = asset(full_photo_path) | imagine_filter('patient_profile') %}
                {% set original_src = asset(full_photo_path) | imagine_filter('patient_viewer_full') %}
            {% endif %}
            {% set avatar = final_src %}

            {# Menú Popover Glass estilo Apple para todos los usuarios (Personal Interno y Pacientes) #}
            <li class="nav-item dropdown apple-user-nav-item" data-controller="apple-popover">
                <a href="#" class="nav-link d-flex align-items-center gap-2 px-2 py-1 rounded-pill apple-nav-user-trigger" 
                   data-bs-toggle="dropdown" 
                   data-bs-auto-close="outside"
                   data-controller="apple-spring"
                   aria-expanded="false">
                    <div class="apple-nav-avatar-wrap">
                        <img
                            src="{{ asset(avatar) }}"
                            class="rounded-circle"
                            alt="{{ display_name }}"
                        >
                    </div>
                    <span class="d-none d-md-inline fw-semibold fs-6 text-body">{{ display_name }}</span>
                    <i class="bi bi-chevron-down fs-7 text-secondary ms-1"></i>
                </a>

                <div class="dropdown-menu dropdown-menu-end apple-user-popover shadow-lg">
                    {# Cabecera de Perfil Apple #}
                    <div class="popover-profile-header">
                        <div class="popover-avatar-wrap">
                            <img src="{{ asset(avatar) }}" alt="{{ display_name }}" class="rounded-circle">
                        </div>
                        <h4 class="popover-user-name">{{ display_name }}</h4>
                        <div class="popover-role-chip">
                            <i class="bi {{ role_icon }} me-1"></i>
                            {{ role_label }}
                        </div>
                        <span class="popover-registered-date">
                            <i class="bi bi-calendar3 me-1"></i> Registrado desde {{ app.user.created|time_since }}
                        </span>
                    </div>

                    <div class="popover-divider"></div>

                    {# Selector de Modo Oscuro dentro del Popover #}
                    <div class="popover-theme-row" data-controller="theme-toggle">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-sun-fill text-warning" data-theme-icon></i>
                            <span class="small fw-semibold text-body" data-theme-label>Modo de Pantalla</span>
                        </div>
                        <button type="button" 
                                class="apple-theme-pill-btn" 
                                data-action="click->theme-toggle#toggle"
                                data-controller="apple-spring">
                            <span>Cambiar</span>
                        </button>
                    </div>

                    <div class="popover-divider"></div>

                    {# Acciones de Perfil #}
                    <div class="popover-actions">
                        {% if is_granted('ROLE_INTERNAL') %}
                            <a href="{{ path('my_internal_profile_show') }}" 
                               class="apple-btn btn-apple-primary w-100 mb-2" 
                               data-controller="apple-spring">
                                <i class="bi bi-person-circle"></i>
                                <span>Mi Perfil</span>
                            </a>
                        {% elseif app.user.externalProfile is not null %}
                            <a href="{{ path('my_profile_show', {'uuid': app.user.externalProfile.uuid}) }}" 
                               class="apple-btn btn-apple-primary w-100 mb-2" 
                               data-controller="apple-spring">
                                <i class="bi bi-person-circle"></i>
                                <span>Mi Perfil</span>
                            </a>
                        {% endif %}

                        <a href="{{ path('app_logout') }}" 
                           class="apple-btn btn-apple-danger w-100" 
                           data-controller="apple-spring">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Cerrar Sesión</span>
                        </a>
                    </div>
                </div>
            </li>
            <!--end::User Menu Dropdown-->
        </ul>
        <!--end::End Navbar Links-->
    </div>
    <!--end::Container-->
</nav>
