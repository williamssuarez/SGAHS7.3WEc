{% import _self as macros %}

{% macro render_menu_items(items) %}
    {% for item in items %}

        {# ---------------------------------------------------------------- #}
        {# 0. SECURITY CHECK                                                #}
        {# ---------------------------------------------------------------- #}
        {# If 'roles' is not defined, we assume it's public/shared.         #}
        {# If 'roles' IS defined, we check against the user's permissions.  #}
        {# ---------------------------------------------------------------- #}

        {% if item.roles is not defined or is_granted(item.roles) %}
            {# ---------------------------------------------------------------- #}
            {# 1. CALCULATE ALL DESCENDANT ROUTES (Including active_routes)     #}

            {% set descendant_routes = [] %}
            {% if item.active_routes is defined %}
                {% set descendant_routes = item.active_routes %}
            {% elseif item.route is defined %}
                {% set descendant_routes = [item.route] %}
            {% endif %}

            {# Only run this check if the item is a parent with children #}
            {% if item.children is defined %}
                {% set stack = item.children %}
                {% for child in stack %}
                    {% if child.active_routes is defined %}
                        {% set descendant_routes = descendant_routes|merge(child.active_routes) %}
                    {% elseif child.route is defined %}
                        {% set descendant_routes = descendant_routes|merge([child.route]) %}
                    {% endif %}

                    {% if child.children is defined %}
                        {% set stack = stack|merge(child.children) %}
                    {% endif %}
                {% endfor %}
            {% endif %}
            {# ---------------------------------------------------------------- #}

            {# 2. Determine Activation Classes #}
            {% if item.children is defined %}
                {% set active_class = is_tree_active(descendant_routes) %}
            {% else %}
                {% set active_class = is_active(descendant_routes) %}
            {% endif %}
            {# ---------------------------------------------------------------- #}

            <li class="nav-item {{ item.children is defined ? 'has-treeview' : '' }} {{ active_class }}">

                {# 3. The Link #}
                {% set target_url = '#' %}
                {% if item.route is defined %}
                    {% if item.route == 'app_my_profile' and app.user and app.user.externalProfile is defined and app.user.externalProfile is not null %}
                        {% set target_url = path('my_profile_show', {'uuid': app.user.externalProfile.uuid}) %}
                    {% else %}
                        {% set target_url = path(item.route) %}
                    {% endif %}
                {% endif %}

                {% set item_active = '' %}
                {% if item.active_routes is defined %}
                    {% set item_active = is_active(item.active_routes) %}
                {% elseif item.route is defined %}
                    {% set item_active = is_active(item.route) %}
                {% endif %}

                <a href="{{ target_url }}"
                   class="nav-link {{ item_active }}"
                   data-controller="apple-spring">

                    {% if item.icon is defined %}
                        <i class="nav-icon {{ item.icon }}"></i>
                    {% else %}
                        <i class="nav-icon bi bi-circle-fill"></i>
                    {% endif %}
                    <p>
                        {{ item.title }}
                        {% if item.children is defined %}
                            <i class="nav-arrow bi bi-chevron-right"></i>
                        {% endif %}
                    </p>
                </a>

                {# 4. Recursion for Children #}
                {% if item.children is defined %}
                    <ul class="nav nav-treeview">
                        {{ _self.render_menu_items(item.children) }}
                    </ul>
                {% endif %}
            </li>
        {% endif %}
    {% endfor %}
{% endmacro %}

<aside class="app-sidebar apple-sidebar shadow-sm">
    <!--begin::Sidebar Brand-->
    <div class="sidebar-brand apple-sidebar-brand">
        <!--begin::Brand Link-->
        <a href="{{ path('app_dashboard') }}" class="brand-link apple-brand-link" data-controller="apple-spring">
            <div class="apple-brand-icon">
                <i class="bi bi-heart-pulse-fill"></i>
            </div>
            <div class="apple-brand-copy">
                <span class="brand-text apple-brand-title">SGAHS</span>
                <span class="apple-brand-subtitle">Salud Hospitalaria</span>
            </div>
        </a>
        <!--end::Brand Link-->
    </div>
    <!--end::Sidebar Brand-->
    <!--begin::Sidebar Wrapper-->
    <div class="sidebar-wrapper">
        <nav class="mt-2">
            <!--begin::Sidebar Menu-->
            <ul
                class="nav sidebar-menu flex-column"
                data-lte-toggle="treeview"
                role="menu"
                data-accordion="false"
            >
                <li class="nav-header apple-nav-header"><span>Módulos del Sistema</span></li>
                {{ macros.render_menu_items(sidebar_menu) }}
            </ul>
            <!--end::Sidebar Menu-->
        </nav>
    </div>
    <!--end::Sidebar Wrapper-->
</aside>
