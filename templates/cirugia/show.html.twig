{% extends 'base.html.twig' %}

{% block title %}Detalles de Cirugía - {{ cirugia.paciente.nombre|first|upper }}. {{ cirugia.paciente.apellido }}{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_cirugia') }}">Cirugías</a></li>
    <li class="breadcrumb-item active" aria-current="page">Expediente Quirúrgico</li>
{% endblock %}

{% block body %}
    <div class="container-fluid px-4">

        {# --- HEADER & ACTIONS --- #}
        <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
            <div>
                <h2 class="text-dark fw-bold mb-0">
                    <i class="bi bi-file-medical"></i> Expediente Quirúrgico <span class="badge bg-secondary fs-6">Solo Lectura</span>
                </h2>
                <p class="text-muted mb-0">
                    Paciente: <a href="{{ path('app_paciente_show', {'id': cirugia.paciente.id}) }}"><strong>{{ cirugia.paciente.nombre }} {{ cirugia.paciente.apellido }}</strong></a>
                    (CI: {{ cirugia.paciente.cedula }})
                </p>
            </div>
            <div class="d-flex gap-2">
                <a href="{{ path('app_cirugia') }}" class="btn btn-outline-secondary shadow-sm">
                    <i class="bi bi-arrow-left"></i> Volver al Historial
                </a>
                <button class="btn btn-outline-dark shadow-sm" onclick="window.print()">
                    <i class="bi bi-printer"></i> Imprimir Expediente
                </button>
            </div>
        </div>

        {# --- CANCELLATION ALERT --- #}
        {% if cirugia.estado.value == 'cancelada' %}
            <div class="alert alert-danger shadow-sm border-start border-danger border-4">
                <h5 class="alert-heading fw-bold"><i class="bi bi-exclamation-triangle-fill"></i> Cirugía Cancelada</h5>
                <hr>
                <p class="mb-0"><strong>Motivo:</strong> {{ cirugia.motivoCancelacion|default('No especificado') }}</p>
            </div>
        {% endif %}

        {# --- MAIN TABS --- #}
        <div class="card shadow-sm border-top border-primary border-4 mb-4">
            <div class="card-header bg-white p-0 border-bottom-0">
                <ul class="nav nav-tabs nav-justified" id="surgeryTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active py-3 fw-bold" id="resumen-tab" data-bs-toggle="tab" data-bs-target="#resumen" type="button" role="tab">
                            <i class="bi bi-clipboard-data"></i> Resumen y Tiempos
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link py-3 fw-bold text-success" id="consumos-tab" data-bs-toggle="tab" data-bs-target="#consumos" type="button" role="tab">
                            <i class="bi bi-box-seam"></i> Consumos (Kardex)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link py-3 fw-bold text-dark" id="protocolo-tab" data-bs-toggle="tab" data-bs-target="#protocolo" type="button" role="tab">
                            <i class="bi bi-journal-check"></i> Protocolo Quirúrgico
                        </button>
                    </li>
                </ul>
            </div>

            <div class="card-body p-4 bg-light">
                <div class="tab-content" id="surgeryTabsContent">

                    {# --- TAB 1: RESUMEN Y TIEMPOS --- #}
                    <div class="tab-pane fade show active" id="resumen" role="tabpanel">
                        <div class="row g-4">

                            {# Left Column: Clinical & Logistics #}
                            <div class="col-lg-8">
                                <div class="card shadow-sm h-100">
                                    <div class="card-header bg-white fw-bold text-primary">
                                        <i class="bi bi-info-circle"></i> Datos del Procedimiento
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-borderless mb-0">
                                            <tbody>
                                            <tr>
                                                <th style="width: 30%" class="text-muted">Procedimiento:</th>
                                                <td class="fw-bold fs-5">{{ cirugia.procedimientoPropuesto }}</td>
                                            </tr>
                                            <tr>
                                                <th class="text-muted">Diagnóstico Pre-Op:</th>
                                                <td>{{ cirugia.diagnosticoPreoperatorio }}</td>
                                            </tr>
                                            <tr>
                                                <th class="text-muted">Lateralidad:</th>
                                                <td>
                                                    <span class="badge bg-secondary">{{ cirugia.lateralidad|default('N/A') }}</span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="2"><hr class="text-muted"></td>
                                            </tr>
                                            <tr>
                                                <th class="text-muted">Cirujano Principal:</th>
                                                <td>Dr(a). {{ cirugia.cirujanoPrincipal.nombre }}</td>
                                            </tr>
                                            <tr>
                                                <th class="text-muted">Quirófano:</th>
                                                <td>
                                                    {% if cirugia.quirofano %}
                                                        <strong>{{ cirugia.quirofano.nombre }}</strong>
                                                    {% else %}
                                                        <span class="text-warning fw-bold"><i class="bi bi-exclamation-circle"></i> No asignado</span>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            {# Right Column: Timestamps & State #}
                            <div class="col-lg-4">
                                <div class="card shadow-sm h-100">
                                    <div class="card-header bg-white fw-bold text-info">
                                        <i class="bi bi-clock-history"></i> Tiempos Quirúrgicos
                                    </div>
                                    <div class="card-body">

                                        {# Current State Badge #}
                                        <div class="text-center mb-4 pb-3 border-bottom">
                                            <h6 class="text-muted mb-2">Estado Registrado</h6>
                                            {% set badge = cirugia.cirugiaEstadosBadgeConfig %}
                                            <span class="badge {{ badge.class }} fs-5 p-2 w-100">{{ badge.label|upper }}</span>
                                        </div>

                                        {# Timeline #}
                                        <ul class="list-group list-group-flush">
                                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                                <span><i class="bi bi-calendar-check text-primary"></i> Programada:</span>
                                                <strong>{{ cirugia.fechaHoraProgramada|date('d/m/Y H:i A', false) }}</strong>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                                <span><i class="bi bi-play-circle text-warning"></i> Anestesia:</span>
                                                <strong class="{{ cirugia.horaInicioAnestesia ? '' : 'text-muted' }}">
                                                    {{ cirugia.horaInicioAnestesia ? cirugia.horaInicioAnestesia|date('H:i A') : '--:--' }}
                                                </strong>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                                <span><i class="bi bi-scissors text-danger"></i> Incisión (Corte):</span>
                                                <strong class="{{ cirugia.horaIncision ? '' : 'text-muted' }}">
                                                    {{ cirugia.horaIncision ? cirugia.horaIncision|date('H:i A') : '--:--' }}
                                                </strong>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                                <span><i class="bi bi-bandaid text-success"></i> Cierre:</span>
                                                <strong class="{{ cirugia.horaCierre ? '' : 'text-muted' }}">
                                                    {{ cirugia.horaCierre ? cirugia.horaCierre|date('H:i A') : '--:--' }}
                                                </strong>
                                            </li>
                                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                                <span><i class="bi bi-box-arrow-right text-secondary"></i> Salida a URPA:</span>
                                                <strong class="{{ cirugia.horaSalidaSala ? '' : 'text-muted' }}">
                                                    {{ cirugia.horaSalidaSala ? cirugia.horaSalidaSala|date('H:i A') : '--:--' }}
                                                </strong>
                                            </li>
                                        </ul>

                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    {# --- TAB 2: CONSUMOS (KARDEX) --- #}
                    <div class="tab-pane fade" id="consumos" role="tabpanel">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="table-responsive bg-white rounded shadow-sm border">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                        <tr>
                                            <th>Hora</th>
                                            <th>Insumo</th>
                                            <th class="text-center">Cant.</th>
                                            <th>Origen</th>
                                            <th>Registrado por</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% for consumo in cirugia.consumoQuirurgicos|sort((a, b) => b.created <=> a.created) %}
                                            <tr>
                                                <td class="text-muted small fw-bold">{{ consumo.created|date('H:i A') }}</td>

                                                <td>
                                                    {% if consumo.aportadoPorPaciente %}
                                                        <span class="text-dark">{{ consumo.descripcionArticuloExterno }}</span>
                                                    {% else %}
                                                        <span class="text-primary fw-bold">{{ consumo.articuloInventario.nombre }}</span>
                                                    {% endif %}
                                                </td>

                                                <td class="text-center fw-bold fs-5">{{ consumo.cantidad }}</td>

                                                <td>
                                                    {% if consumo.aportadoPorPaciente %}
                                                        <span class="badge bg-warning text-dark"><i class="bi bi-person"></i> Paciente</span>
                                                    {% else %}
                                                        <span class="badge bg-success"><i class="bi bi-hospital"></i> Hospital</span>
                                                    {% endif %}
                                                </td>

                                                <td class="small text-muted">
                                                    {{ consumo.uidCreate|public_username }}
                                                </td>
                                            </tr>
                                        {% else %}
                                            <tr>
                                                <td colspan="5" class="text-center py-5 text-muted">
                                                    <i class="bi bi-box-seam display-4 d-block mb-3 opacity-50"></i>
                                                    No se registraron insumos en esta cirugía.
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# --- TAB 3: PROTOCOLO OPERATORIO --- #}
                    <div class="tab-pane fade" id="protocolo" role="tabpanel">

                        {% if cirugia.protocoloOperatorio %}
                            {# THE LEGAL READ-ONLY DOCUMENT #}
                            <div class="card border-0 shadow-sm bg-white">
                                <div class="card-header bg-light border-bottom py-3 d-flex justify-content-between align-items-center">
                                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-file-earmark-medical"></i> Protocolo Quirúrgico Oficial</h5>
                                </div>

                                <div class="card-body p-5">
                                    <div class="row mb-4">
                                        <div class="col-md-6">
                                            <p class="text-muted mb-1">Redactado y Firmado por:</p>
                                            <h5 class="fw-bold">{{ cirugia.protocoloOperatorio.uidCreate|doctor_username }}</h5>
                                        </div>
                                        <div class="col-md-6 text-md-end">
                                            <p class="text-muted mb-1">Fecha y Hora de Firma:</p>
                                            <h5 class="fw-bold">{{ cirugia.protocoloOperatorio.created|date('d/m/Y H:i A') }}</h5>
                                        </div>
                                    </div>

                                    <hr class="mb-4">

                                    <div class="mb-4">
                                        <h6 class="text-primary fw-bold text-uppercase">1. Hallazgos</h6>
                                        <p class="fs-5">{{ cirugia.protocoloOperatorio.hallazgos|nl2br }}</p>
                                    </div>

                                    <div class="mb-4">
                                        <h6 class="text-primary fw-bold text-uppercase">2. Técnica Quirúrgica</h6>
                                        <p class="fs-5">{{ cirugia.protocoloOperatorio.tecnicaQuirurgica|nl2br }}</p>
                                    </div>

                                    <div class="row bg-light p-3 rounded">
                                        <div class="col-md-4">
                                            <strong class="d-block text-muted">Sangrado Estimado</strong>
                                            <span class="fs-5">{{ cirugia.protocoloOperatorio.sangradoEstimado }} cc</span>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="d-block text-muted">Complicaciones</strong>
                                            <span class="fs-5">{{ cirugia.protocoloOperatorio.complicaciones|default('Ninguna reportada') }}</span>
                                        </div>
                                        <div class="col-md-4">
                                            <strong class="d-block text-muted">Muestra a Patología</strong>
                                            <span class="badge {{ cirugia.protocoloOperatorio.envioPatologia ? 'bg-success' : 'bg-secondary' }} fs-6">
                                                {{ cirugia.protocoloOperatorio.envioPatologia ? 'SÍ ENVIADA' : 'NO' }}
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="alert alert-light border text-center p-5">
                                <i class="bi bi-file-earmark-x display-4 d-block mb-3 text-muted"></i>
                                <h4 class="text-dark">Sin Protocolo Registrado</h4>
                                <p class="text-muted mb-0">No se elaboró un protocolo quirúrgico para este procedimiento.</p>
                            </div>
                        {% endif %}

                    </div>

                </div>
            </div>
        </div>
    </div>
{% endblock %}
