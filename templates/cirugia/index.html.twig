{% extends 'base.html.twig' %}

{% block title %}Historial de Cirugías{% endblock %}

{% block titlewrap %}
    Historial Quirúrgico Global
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">Cirugías</li>
{% endblock %}

{% block body %}
    <div class="card shadow-sm mb-4">
        <div class="card-body bg-light rounded">
            <form method="post" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-bold text-muted">Desde</label>
                    <input type="date" name="start_date" class="form-control" value="{{ startDate }}">
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold text-muted">Hasta</label>
                    <input type="date" name="end_date" class="form-control" value="{{ endDate }}">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold text-muted">Estado</label>
                    <select name="estado_filtro" class="form-select noSrchSelect">
                        <option value="TODAS" {% if estadoFiltro == 'TODAS' %}selected{% endif %}>Todas las Cirugías</option>
                        {% for st in estadosDisponibles %}
                            <option value="{{ st.value }}" {% if estadoFiltro == st.value %}selected{% endif %}>{{ st.value|replace({'_': ' '})|title }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel-fill"></i> Filtrar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold"><i class="bi bi-journal-medical text-info"></i> Registro Histórico de Cirugías</h5>
            <a href="{{ path('app_cirugia_programar') }}" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg"></i> Programar Nueva
            </a>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle dtHere">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha y Hora</th>
                            <th>Paciente</th>
                            <th>Cédula</th>
                            <th>Procedimiento</th>
                            <th>Quirófano</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for cirugia in cirugias %}
                            <tr>
                                <td>
                                    <span class="d-none">{{ cirugia.fechaHoraProgramada|date('Y-m-d H:i') }}</span>
                                    <div class="fw-bold">{{ cirugia.fechaHoraProgramada|date('d/m/Y') }}</div>
                                    <small class="text-muted">{{ cirugia.fechaHoraProgramada|date('h:i A') }}</small>
                                </td>
                                <td>
                                    {{ cirugia.paciente.nombre }} {{ cirugia.paciente.apellido }}
                                </td>
                                <td>{{ cirugia.paciente.tipoDocumento }} - {{ cirugia.paciente.cedula|number_format(0, ',', '.') }}</td>
                                <td>
                                    {{ cirugia.procedimientoPropuesto }}
                                    <br><small class="text-muted">Dr(a). {{ cirugia.cirujanoPrincipal.nombre }}</small>
                                </td>
                                <td>{{ cirugia.quirofano ? cirugia.quirofano.nombre : '<span class="text-muted">N/A</span>'|raw }}</td>
                                <td>
                                    {% set badge = cirugia.cirugiaEstadosBadgeConfig %}
                                    <span class="badge {{ badge.class }} shadow-sm px-2 py-1">{{ badge.label }}</span>
                                </td>
                                <td>
                                    <a class="btn btn-sm btn-outline-primary" href="{{ path('app_cirugia_show', {'id': cirugia.id}) }}" title="Ver Detalles">
                                        <i class="bi bi-eye-fill"></i> Detalles
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
