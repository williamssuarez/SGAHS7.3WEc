<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Expediente Quirúrgico</title>
    <style>
        body { font-family: Helvetica, Arial, sans-serif; font-size: 11px; color: #333; line-height: 1.4; }
        .header { text-align: center; border-bottom: 2px solid #2c3e50; padding-bottom: 10px; margin-bottom: 15px; }
        .hospital-name { font-size: 16px; font-weight: bold; color: #2c3e50; text-transform: uppercase; }
        .doc-title { font-size: 14px; font-weight: bold; margin-top: 5px; }

        .section-title { background-color: #f2f2f2; font-weight: bold; padding: 4px; border: 1px solid #ccc; margin-top: 10px; margin-bottom: 5px; text-transform: uppercase; font-size: 10px;}

        table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
        td, th { border: 1px solid #ddd; padding: 4px; text-align: left; vertical-align: top; }
        th { background-color: #fafafa; width: 20%; color: #555; font-size: 10px;}
        td { font-size: 10px; }

        .footer { margin-top: 40px; text-align: center; page-break-inside: avoid; }
        .signature-line { border-top: 1px solid #000; width: 250px; margin: 0 auto; padding-top: 5px; }
    </style>
</head>
<body>

<div class="header">
    <div class="hospital-name">{{ mainConfig.nombreInstitucion }}</div>
    <div>Centro Quirúrgico</div>
    <div class="doc-title">EXPEDIENTE DE PROCEDIMIENTO QUIRÚRGICO</div>
    <div style="font-size: 10px; color: #777; margin-top: 5px;">
        Generado el: {{ 'now'|date('d/m/Y H:i') }} | Ref: #{{ entity.id }}
    </div>
</div>

<div class="section-title">Datos del Paciente</div>
<table>
    <tr>
        <th>Nombre Completo:</th>
        <td>{{ entity.paciente.nombre ~ ' ' ~ entity.paciente.apellido }}</td>
        <th>Documento (CI):</th>
        <td>{{ entity.paciente.tipoDocumento }} - {{ entity.paciente.cedula|number_format(0, '', '.') }}</td>
    </tr>
</table>

<div class="section-title">Datos de la Cirugía</div>
<table>
    <tr>
        <th>Quirófano:</th>
        <td>{{ entity.quirofano ? entity.quirofano.nombre : 'No asignado' }}</td>
        <th>Lateralidad:</th>
        <td>{{ entity.lateralidad|default('N/A') }}</td>
    </tr>
    <tr>
        <th>Cirujano Principal:</th>
        <td>{{ entity.cirujanoPrincipal ? 'Dr(a). ' ~ entity.cirujanoPrincipal.nombre ~ ' ' ~ entity.cirujanoPrincipal.apellido : 'N/A' }}</td>
        <th>Anestesiólogo:</th>
        <td>{{ entity.anestesiologo ? 'Dr(a). ' ~ entity.anestesiologo.nombre ~ ' ' ~ entity.anestesiologo.apellido : 'N/A' }}</td>
    </tr>
    <tr>
        <th>Fecha Programada:</th>
        <td colspan="3">{{ entity.fechaHoraProgramada|date('d/m/Y h:i A') }}</td>
    </tr>
    <tr>
        <th>Entrada a Sala:</th>
        <td>{{ entity.horaIngresoSala ? entity.horaIngresoSala|date('d/m/Y h:i A') : 'N/A' }}</td>
        <th>Salida de Sala:</th>
        <td>{{ entity.horaSalidaSala ? entity.horaSalidaSala|date('d/m/Y h:i A') : 'N/A' }}</td>
    </tr>
</table>

<div class="section-title">Resumen Clínico</div>
<table>
    <tr>
        <th>Diagnóstico Preoperatorio:</th>
        <td colspan="3">{{ entity.diagnosticoPreoperatorio|default('N/A') }}</td>
    </tr>
    <tr>
        <th>Procedimiento Propuesto:</th>
        <td colspan="3">{{ entity.procedimientoPropuesto|default('N/A') }}</td>
    </tr>
</table>

{% if entity.protocoloOperatorio %}
    <div class="section-title">Protocolo Operatorio</div>
    <table>
        <tr>
            <th>Hallazgos Quirúrgicos:</th>
            <td>{{ entity.protocoloOperatorio.hallazgos|nl2br }}</td>
        </tr>
        <tr>
            <th>Técnica Quirúrgica:</th>
            <td>{{ entity.protocoloOperatorio.tecnicaQuirurgica|nl2br }}</td>
        </tr>
        <tr>
            <th>Complicaciones:</th>
            <td>{{ entity.protocoloOperatorio.complicaciones ? entity.protocoloOperatorio.complicaciones|nl2br : 'Ninguna reportada' }}</td>
        </tr>
        <tr>
            <th>Sangrado Estimado:</th>
            <td>{{ entity.protocoloOperatorio.sangradoEstimado }} ml</td>
        </tr>
        <tr>
            <th>Envío a Patología:</th>
            <td>{{ entity.protocoloOperatorio.envioPatologia ? 'Sí' : 'No' }}</td>
        </tr>
    </table>
{% endif %}

<div class="section-title">Insumos y Consumos Registrados</div>
{% if entity.consumoQuirurgicos|length > 0 %}
    <table>
        <tr>
            <th style="width: 50%">Artículo / Insumo</th>
            <th style="width: 20%">Cantidad</th>
            <th style="width: 30%">Origen</th>
        </tr>
        {% for consumo in entity.consumoQuirurgicos %}
            <tr>
                <td>{{ consumo.aportadoPorPaciente ? consumo.descripcionArticuloExterno : consumo.articuloInventario.nombre }}</td>
                <td>{{ consumo.cantidad }}</td>
                <td>{{ consumo.aportadoPorPaciente ? 'Aportado por Paciente' : 'Suministrado por Hospital' }}</td>
            </tr>
        {% endfor %}
    </table>
{% else %}
    <p style="font-style: italic; color: #777; font-size: 10px;">No se registraron consumos en esta cirugía.</p>
{% endif %}

<div class="footer">
    <div class="signature-line">
        <strong>Firma y Sello del Cirujano Principal</strong><br>
        <span style="font-size: 9px; color: #777;">Documento generado electrónicamente por {{ mainConfig.nombreInstitucion }}</span><br>
        <span style="font-size: 9px; color: #777;">Dr(a). {{ entity.cirujanoPrincipal ? entity.cirujanoPrincipal.nombre ~ ' ' ~ entity.cirujanoPrincipal.apellido : 'N/A' }}</span>
    </div>
</div>

</body>
</html>
