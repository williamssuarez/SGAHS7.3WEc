{% extends 'base.html.twig' %}

{% block title %}Gestión de Camas{% endblock %}

{% block titlewrap %}
    Camas
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">Camas</li>
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
        <h2 class="text-dark fw-bold">
            <i class="fa-solid fa-bed"></i> Gestión de Camas Clínicas
        </h2>
        <a href="{{ path('app_hospitalizacioncama_new') }}" class="btn btn-primary shadow-sm fw-bold">
            <i class="bi bi-plus-circle-fill"></i> Registrar Cama
        </a>
    </div>

    <div class="card shadow-sm border-top border-primary border-4 mb-4">
        <div class="card-body p-0">
            {% if entities is empty %}
                <div class="text-center p-5">
                    <i class="fa-solid fa-bed text-muted display-1 mb-3"></i>
                    <h4 class="text-muted">No hay camas registradas</h4>
                    <p class="text-muted">Instala camas dentro de las habitaciones para poder admitir pacientes.</p>
                </div>
            {% else %}
                <div class="table-responsive" style="min-height: 350px;">
                    <table class="table table-hover align-middle mb-0 dtHere">
                        <thead class="table-light">
                        <tr>
                            <th>Código de Cama</th>
                            <th>Ubicación (Área / Habitación)</th>
                            <th class="text-center">Estado Operativo</th>
                            <th class="text-end">Acciones / Mantenimiento</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for entity in entities %}
                            <tr>
                                <td>
                                    <strong><i class="fa-solid fa-bed text-secondary me-1"></i> Cama {{ entity.codigo }}</strong>
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="text-primary fw-bold small"><i class="bi bi-building"></i> {{ entity.habitacion.area.nombre }}</span>
                                        <span class="text-muted"><i class="bi bi-door-open"></i> {{ entity.habitacion.nombre }}</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    {% set badge = entity.estadosBadgeConfig %}
                                    <span class="badge rounded-pill {{ badge.class }} fs-6 shadow-sm">
                                        {{ badge.label }}
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle shadow-sm" type="button" id="dropdownCama{{ entity.id }}" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-gear-fill"></i> Opciones
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="dropdownCama{{ entity.id }}">
                                            {% if entity.estado.value != 'ocupied' %}
                                                <li>
                                                    <a class="dropdown-item" href="{{ path('app_hospitalizacioncama_edit', {'id': entity.id}) }}">
                                                        <i class="bi bi-pencil-square text-primary me-2"></i> Editar Registro
                                                    </a>
                                                </li>
                                                
                                                {% if entity.estado.value == 'available' %}
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <form action="{{ path('app_hospitalizacioncama_cleaning', {'id': entity.id}) }}"
                                                              method="POST"
                                                              data-controller="confirm-finalizar"
                                                              data-action="submit->confirm-finalizar#confirm"
                                                              data-confirm-finalizar-title-value="¿Solicitar Limpieza?"
                                                              data-confirm-finalizar-text-value="¿Desea solicitar la limpieza? Esto no permitirá que sea elegible para hospitalizaciones."
                                                              data-confirm-finalizar-confirm-button-text-value="Sí, solicitar limpieza"
                                                              class="m-0">
                                                            <button type="submit" class="dropdown-item">
                                                                <i class="fa-solid fa-broom text-warning me-2"></i> Solicitar Limpieza
                                                            </button>
                                                        </form>
                                                    </li>
                                                    <li>
                                                        <form action="{{ path('app_hospitalizacioncama_maintenance', {'id': entity.id}) }}"
                                                              method="POST"
                                                              data-controller="confirm-finalizar"
                                                              data-action="submit->confirm-finalizar#confirm"
                                                              data-confirm-finalizar-title-value="¿Mandar a Mantenimiento?"
                                                              data-confirm-finalizar-text-value="¿Desea mandar la cama a mantenimiento? Esto no permitirá que sea elegible para hospitalizaciones."
                                                              data-confirm-finalizar-confirm-button-text-value="Sí, mandar a Mantenimiento"
                                                              class="m-0">
                                                            <button type="submit" class="dropdown-item">
                                                                <i class="bi bi-tools text-danger me-2"></i> Reportar Falla (Mantenimiento)
                                                            </button>
                                                        </form>
                                                    </li>
                                                {% elseif entity.estado.value == 'cleaning' %}
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <form action="{{ path('app_hospitalizacioncama_finish_cleaning', {'id': entity.id}) }}"
                                                              method="POST"
                                                              data-controller="confirm-finalizar"
                                                              data-action="submit->confirm-finalizar#confirm"
                                                              data-confirm-finalizar-title-value="¿Finalizar la Limpieza?"
                                                              data-confirm-finalizar-text-value="Si la cama ya esta limpia puede finalizar la limpieza y la cama estará disponible para que sea elegible para hospitalizaciones."
                                                              data-confirm-finalizar-confirm-button-text-value="Sí, finalizar"
                                                              class="m-0">
                                                            <button type="submit" class="dropdown-item fw-bold">
                                                                <i class="bi bi-check-circle-fill text-success me-2"></i> Finalizar Limpieza
                                                            </button>
                                                        </form>
                                                    </li>
                                                    <li>
                                                        <form action="{{ path('app_hospitalizacioncama_maintenance', {'id': entity.id}) }}"
                                                              method="POST"
                                                              data-controller="confirm-finalizar"
                                                              data-action="submit->confirm-finalizar#confirm"
                                                              data-confirm-finalizar-title-value="¿Mandar a Mantenimiento?"
                                                              data-confirm-finalizar-text-value="¿Desea mandar la cama a mantenimiento? Esto no permitirá que sea elegible para hospitalizaciones."
                                                              data-confirm-finalizar-confirm-button-text-value="Sí, mandar a Mantenimiento"
                                                              class="m-0">
                                                            <button type="submit" class="dropdown-item">
                                                                <i class="bi bi-tools text-danger me-2"></i> Reportar Falla (Mantenimiento)
                                                            </button>
                                                        </form>
                                                    </li>
                                                {% elseif entity.estado.value == 'maintenance' %}
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <form action="{{ path('app_hospitalizacioncama_reactivate', {'id': entity.id}) }}"
                                                              method="POST"
                                                              data-controller="confirm-finalizar"
                                                              data-action="submit->confirm-finalizar#confirm"
                                                              data-confirm-finalizar-title-value="¿Reactivar la Cama?"
                                                              data-confirm-finalizar-text-value="La cama estará disponible para que sea elegible para hospitalizaciones."
                                                              data-confirm-finalizar-confirm-button-text-value="Sí, reactivar"
                                                              class="m-0">
                                                            <button type="submit" class="dropdown-item fw-bold">
                                                                <i class="fa-solid fa-screwdriver-wrench text-success me-2"></i> Reactivar Cama
                                                            </button>
                                                        </form>
                                                    </li>
                                                {% endif %}
                                            {% else %}
                                                <li>
                                                    <span class="dropdown-item text-muted fst-italic">
                                                        <i class="bi bi-lock-fill me-2"></i> Ocupada actualmente
                                                    </span>
                                                </li>
                                            {% endif %}
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
