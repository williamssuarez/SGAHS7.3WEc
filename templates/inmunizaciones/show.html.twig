{% extends 'catalog/_base_show.html.twig' %}

{% set catalog_title = 'Inmunizaciones' %}
{% set catalog_singular = 'Inmunización' %}
{% set catalog_icon = 'bi-shield-check' %}
{% set index_route = 'app_inmunizaciones_index' %}
{% set edit_route = 'app_inmunizaciones_edit' %}
{% set delete_route = 'app_inmunizaciones_delete' %}

{% block detail_content %}
    <div class="mb-3">
        <label class="text-secondary small fw-semibold text-uppercase d-block mb-1">Nombre</label>
        <div class="fs-5 fw-bold text-body">{{ entity.nombre }}</div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-sm-6">
            <label class="text-secondary small fw-semibold text-uppercase d-block mb-1">Tipo</label>
            <div>
                {% set badge = entity.inmunizacionesTiposBadgeConfig %}
                <span class="apple-role-pill {{ badge.class }}">
                    {{ badge.label }}
                </span>
            </div>
        </div>
        <div class="col-sm-6">
            <label class="text-secondary small fw-semibold text-uppercase d-block mb-1">Vía de Administración</label>
            <div>
                {% set badge = entity.inmunizacionesAdministracionesBadgeConfig %}
                <span class="apple-role-pill {{ badge.class }}">
                    {{ badge.label }}
                </span>
            </div>
        </div>
    </div>
    <div class="mb-3">
        <label class="text-secondary small fw-semibold text-uppercase d-block mb-1">Frecuencia Sugerida</label>
        <div class="text-body fw-medium">{{ entity.frecuenciaSugerida|default('No especificada') }}</div>
    </div>
    <div class="mb-2">
        <label class="text-secondary small fw-semibold text-uppercase d-block mb-1">Descripción</label>
        <div class="text-body">{{ entity.descripcion|default('Sin descripción registrada') }}</div>
    </div>
{% endblock %}
