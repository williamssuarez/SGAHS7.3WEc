{% extends 'catalog/_base_index.html.twig' %}
{% import 'catalog/_actions.html.twig' as actions %}

{% set catalog_title = 'Inmunizaciones' %}
{% set catalog_header_title = 'Inmunizaciones Registradas' %}
{% set catalog_subtitle = 'Listado y esquemas de vacunas e inmunizaciones registradas en el sistema' %}
{% set catalog_icon = 'bi-shield-check' %}
{% set new_route = 'app_inmunizaciones_new' %}

{% block table_head %}
    <th>Nombre</th>
    <th>Tipo</th>
    <th>Administración</th>
    <th>Frecuencia Sugerida</th>
    <th>Descripción</th>
{% endblock %}

{% block table_body %}
    {% for entity in entities %}
        <tr>
            <td class="fw-semibold">{{ entity.nombre }}</td>
            <td>
                {% set badge = entity.inmunizacionesTiposBadgeConfig %}
                <span class="apple-role-pill {{ badge.class }}">
                    {{ badge.label }}
                </span>
            </td>
            <td>
                {% set badge = entity.inmunizacionesAdministracionesBadgeConfig %}
                <span class="apple-role-pill {{ badge.class }}">
                    {{ badge.label }}
                </span>
            </td>
            <td>{{ entity.frecuenciaSugerida|default('N/A') }}</td>
            <td class="text-muted">{{ entity.descripcion|default('Sin descripción') }}</td>
            <td>
                {{ actions.row_actions(
                    path('app_inmunizaciones_show', {'id': entity.id}),
                    path('app_inmunizaciones_edit', {'id': entity.id}),
                    path('app_inmunizaciones_delete', {'id': entity.id}),
                    entity.id
                ) }}
            </td>
        </tr>
    {% endfor %}
{% endblock %}
