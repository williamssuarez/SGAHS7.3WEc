<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Reporte de Auditoría</title>
    <style>
        body { font-family: sans-serif; font-size: 12px; color: #333; }
        .header { text-align: center; margin-bottom: 20px; }
        .header h1 { margin: 0; font-size: 18px; color: #0056b3; }
        .header p { margin: 5px 0; color: #555; }
        .filters { margin-bottom: 20px; padding: 10px; background-color: #f8f9fa; border: 1px solid #ddd; }
        .filters strong { color: #000; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f4f4f4; color: #333; font-weight: bold; }
        tr:nth-child(even) { background-color: #f9f9f9; }
        .badge { padding: 3px 6px; font-size: 10px; border-radius: 10px; color: #fff; display: inline-block; }
        .bg-success { background-color: #28a745; }
        .bg-primary { background-color: #007bff; }
        .bg-warning { background-color: #ffc107; color: #000; }
        .bg-danger { background-color: #dc3545; }
        .bg-info { background-color: #17a2b8; }
        .bg-secondary { background-color: #6c757d; }
    </style>
</head>
<body>
    <div class="header">
        <h1>SGAHS</h1>
        <p>Reporte de Registro de Auditoría</p>
    </div>

    <div class="filters">
        <table style="border: none; margin: 0; padding: 0;">
            <tr>
                <td style="border: none; padding: 0;"><strong>Desde:</strong> {{ startDate }}</td>
                <td style="border: none; padding: 0;"><strong>Hasta:</strong> {{ endDate }}</td>
                <td style="border: none; padding: 0;"><strong>Filtro de Estado:</strong> {{ state == 'all' ? 'Todos' : state }}</td>
            </tr>
            <tr>
                <td style="border: none; padding: 0; padding-top: 10px;"><strong>Generado por:</strong> {{ generatedBy.id|public_username|title }}</td>
                <td style="border: none; padding: 0; padding-top: 10px;"><strong>Fecha de Generación:</strong> {{ generationDate|date('d/m/Y h:i A') }}</td>
                <td style="border: none; padding: 0; padding-top: 10px;"></td>
            </tr>
        </table>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Fecha y Hora</th>
                <th>Tipo</th>
                <th>Descripción</th>
                <th>Usuario</th>
                <th>Dirección IP</th>
            </tr>
        </thead>
        <tbody>
            {% for audit in audits %}
                <tr>
                    <td>#{{ audit.id }}</td>
                    <td>{{ audit.created|date('d/m/Y h:i A') }}</td>
                    <td>
                        {% set bg_class = 'bg-secondary' %}
                        {% if audit.tipoAudit.value == 'login_success' %} {% set bg_class = 'bg-success' %}
                        {% elseif audit.tipoAudit.value == 'logout' %} {% set bg_class = 'bg-secondary' %}
                        {% elseif audit.tipoAudit.value == 'create' %} {% set bg_class = 'bg-primary' %}
                        {% elseif audit.tipoAudit.value == 'update' %} {% set bg_class = 'bg-warning' %}
                        {% elseif audit.tipoAudit.value == 'delete' %} {% set bg_class = 'bg-danger' %}
                        {% elseif audit.tipoAudit.value == 'login_failed' %} {% set bg_class = 'bg-danger' %}
                        {% endif %}
                        <span class="badge {{ bg_class }}">{{ audit.tipoAudit.readableText }}</span>
                    </td>
                    <td>{{ audit.descripcion }}</td>
                    <td>{{ audit.uidCreate|public_username|title }}</td>
                    <td>{{ audit.direccionIp }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</body>
</html>






