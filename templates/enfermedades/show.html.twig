{% extends 'catalog/_base_show.html.twig' %}

{% set catalog_title = 'Enfermedades' %}
{% set catalog_singular = 'Enfermedad' %}
{% set catalog_icon = 'bi-virus2' %}
{% set index_route = 'app_enfermedades_index' %}
{% set edit_route = 'app_enfermedades_edit' %}
{% set delete_route = 'app_enfermedades_delete' %}

{% block detail_content %}
    <div class="mb-3">
        <label class="text-secondary small fw-semibold text-uppercase d-block mb-1">Nombre</label>
        <div class="fs-5 fw-bold text-body">{{ entity.nombre }}</div>
    </div>
    <div class="mb-3">
        <label class="text-secondary small fw-semibold text-uppercase d-block mb-1">Categoría</label>
        <div>
            {% set badge = entity.enfermedadesCategoriasBadgeConfig %}
            <span class="apple-role-pill {{ badge.class }}">
                {{ badge.label }}
            </span>
        </div>
    </div>
    <div class="mb-2">
        <label class="text-secondary small fw-semibold text-uppercase d-block mb-1">Descripción</label>
        <div class="text-body">{{ entity.descripcion|default('Sin descripción registrada') }}</div>
    </div>
{% endblock %}
