{% extends 'base.html.twig' %}

{% block title %}Nuevo sector de la parroquia {{ parroquia.nombre }}{% endblock %}

{% block titlewrap %}
    Nuevo sector de la parroquia {{ parroquia.nombre }}
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_municipio_show', {'id': municipio.id}) }}">Parroquias del municipio {{ municipio.nombre }}</a></li>
    <li class="breadcrumb-item"><a href="{{ path('app_parroquia_show', {'id': parroquia.id}) }}">Sectores de la parroquia {{ parroquia.nombre }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">Nuevo Sector</li>
{% endblock %}

{% block body %}
    <div class="col-md-6">
        <div class="card card-primary card-outline mb-4">
            {{ include('sector/_form.html.twig') }}
        </div>
    </div>
{% endblock %}
