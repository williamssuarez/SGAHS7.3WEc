{% extends 'base.html.twig' %}

{% block title %}Sector{% endblock %}

{% block body %}
    <h1>Sector</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ sector.id }}</td>
            </tr>
            <tr>
                <th>Nombre</th>
                <td>{{ sector.nombre }}</td>
            </tr>
            <tr>
                <th>UidCreate</th>
                <td>{{ sector.uidCreate }}</td>
            </tr>
            <tr>
                <th>UidUpdate</th>
                <td>{{ sector.uidUpdate }}</td>
            </tr>
            <tr>
                <th>Created</th>
                <td>{{ sector.created ? sector.created|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Updated</th>
                <td>{{ sector.updated ? sector.updated|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_sector_index') }}">back to list</a>

    <a href="{{ path('app_sector_edit', {'id': sector.id}) }}">edit</a>

    {{ include('sector/_delete_form.html.twig') }}
{% endblock %}
