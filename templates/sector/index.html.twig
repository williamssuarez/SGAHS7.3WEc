{% extends 'base.html.twig' %}

{% block title %}Sector index{% endblock %}

{% block body %}
    <h1>Sector index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>UidCreate</th>
                <th>UidUpdate</th>
                <th>Created</th>
                <th>Updated</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for sector in sectors %}
            <tr>
                <td>{{ sector.id }}</td>
                <td>{{ sector.nombre }}</td>
                <td>{{ sector.uidCreate }}</td>
                <td>{{ sector.uidUpdate }}</td>
                <td>{{ sector.created ? sector.created|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ sector.updated ? sector.updated|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_sector_show', {'id': sector.id}) }}">show</a>
                    <a href="{{ path('app_sector_edit', {'id': sector.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_sector_new') }}">Create new</a>
{% endblock %}
