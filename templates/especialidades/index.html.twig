{% extends 'catalog/_base_index.html.twig' %}
{% import 'catalog/_actions.html.twig' as actions %}

{% set catalog_title = 'Especialidades' %}
{% set catalog_header_title = 'Especialidades Registradas' %}
{% set catalog_subtitle = 'Administración de especialidades médicas, cupos de citas y cuerpo médico' %}
{% set catalog_icon = 'bi-heart-pulse' %}
{% set new_route = 'app_especialidades_new' %}

{% block table_head %}
    <th>Nombre</th>
    <th>Descripción</th>
{% endblock %}

{% block table_body %}
    {% for entity in entities %}
        <tr>
            <td class="fw-semibold">{{ entity.nombre }}</td>
            <td class="text-muted">{{ entity.descripcion|default('Sin descripción') }}</td>
            <td>
                {{ actions.row_actions(
                    path('app_especialidades_show', {'id': entity.id}),
                    path('app_especialidades_edit', {'id': entity.id}),
                    path('app_especialidades_delete', {'id': entity.id}),
                    entity.id
                ) }}
            </td>
        </tr>
    {% endfor %}
{% endblock %}
