{{ form_start(form, {
    'attr': {
        'data-controller': 'submit-once',
        'data-action': 'submit->submit-once#disable'
    }
}) }}
{{ include('base/_form_error_messages.html.twig', ignore_missing = true) }}

<div class="mb-3">
    {{ form_label(form.nombre, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
    {{ form_widget(form.nombre, {
        'attr': {
            'placeholder': 'Ej. Cardiología, Pediatría...',
            'autocomplete': 'off'
        }
    }) }}
    {% if not form.nombre.vars.valid %}
        <div class="apple-field-error">{{ form_errors(form.nombre) }}</div>
    {% endif %}
</div>

<div class="mb-3">
    {{ form_label(form.descripcion, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
    {{ form_widget(form.descripcion, {
        'attr': {
            'rows': 3,
            'placeholder': 'Describe brevemente el área clínica de la especialidad...',
            'style': 'resize: vertical;'
        }
    }) }}
    {% if not form.descripcion.vars.valid %}
        <div class="apple-field-error">{{ form_errors(form.descripcion) }}</div>
    {% endif %}
</div>

<div class="d-flex flex-column-reverse flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2 pt-3 mt-3 border-top border-secondary-subtle">
    <a class="btn btn-secondary apple-btn-secondary rounded-pill px-3 py-2 d-inline-flex align-items-center justify-content-center gap-2"
       href="{{ path('app_especialidades_index') }}"
       data-controller="apple-spring">
        <i class="bi bi-arrow-left"></i>
        <span>Volver</span>
    </a>

    <button type="submit"
            class="btn btn-primary apple-btn-primary rounded-pill px-4 py-2 d-inline-flex align-items-center justify-content-center gap-2"
            data-submit-once-target="submitButton"
            data-controller="apple-spring">
        <i class="bi bi-check2-circle"></i>
        <span>{{ button_label|default('Guardar') }}</span>
    </button>
</div>
{{ form_end(form) }}
