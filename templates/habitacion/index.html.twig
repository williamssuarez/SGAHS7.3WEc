{% extends 'base.html.twig' %}

{% block title %}Habitaciones de Hospitalización{% endblock %}

{% block titlewrap %}
    Habitaciones
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">Habitaciones</li>
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
        <h2 class="text-dark fw-bold">
            <i class="bi bi-door-open"></i> Habitaciones Registradas
        </h2>
        <a href="{{ path('app_habitacion_new') }}" class="btn btn-primary shadow-sm fw-bold">
            <i class="bi bi-plus-circle-fill"></i> Registrar Habitación
        </a>
    </div>

    <div class="card shadow-sm border-top border-primary border-4 mb-4">
        <div class="card-body p-0">
            {% if entities is empty %}
                <div class="text-center p-5">
                    <i class="bi bi-door-closed text-muted display-1 mb-3"></i>
                    <h4 class="text-muted">No hay habitaciones registradas</h4>
                    <p class="text-muted">Añade habitaciones y asígnalas a un área específica.</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 dtHere">
                        <thead class="table-light">
                        <tr>
                            <th>Nombre de Habitación</th>
                            <th>Ubicación / Detalles</th>
                            <th>Área Pertenciente</th>
                            <th class="text-center">Camas Instaladas</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for entity in entities %}
                            <tr>
                                <td>
                                    <strong><i class="bi bi-door-open-fill text-secondary me-1"></i> {{ entity.nombre }}</strong>
                                </td>
                                <td>
                                    <span class="text-muted">{{ entity.ubicacion|default('N/A') }}</span>
                                </td>
                                <td>
                                    <span class="badge bg-primary fs-6 shadow-sm">
                                        <i class="bi bi-building"></i> {{ entity.area.nombre }}
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border border-secondary rounded-pill fs-6">
                                        <i class="fa-solid fa-bed text-primary"></i> {{ entity.camasHospitalizaciones|length }} Camas
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group shadow-sm">
                                        <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_habitacion_show', {'id': entity.id}) }}" title="Ver Detalles">
                                            <i class="bi bi-search"></i>
                                        </a>
                                        <a class="btn btn-outline-primary btn-sm" href="{{ path('app_habitacion_edit', {'id': entity.id}) }}" title="Editar Habitación">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
