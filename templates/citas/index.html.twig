{% extends 'base.html.twig' %}

{% block title %}Administracion de Citas{% endblock %}

{% block titlewrap %}
    Administracion de Citas
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">Administracion de Citas</li>
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}
    <div class="card card-primary card-outline mb-4">
        <div class="card-body">
            <form method="get" action="{{ path('app_citas_index_list') }}" class="row g-3 mb-4">
                <div class="row">
                    <div class="col-md-3">
                        <label>Desde</label>
                        <input type="date" name="startDate" value="{{ startDate }}" class="form-control">
                    </div>
                    <div class="col-md-3">
                        <label>Hasta</label>
                        <input type="date" name="endDate" value="{{ endDate }}" class="form-control">
                    </div>
                    <div class="col-md-3">
                        <label>Estado</label>
                        <select name="state" class="form-control noSrchSelect">
                            <option value="expected" {{ currentState == 'expected' ? 'selected' }}>Esperado</option>
                            <option value="checked_in" {{ currentState == 'checked_in' ? 'selected' }}>Atendido</option>
                            <option value="completed" {{ currentState == 'completed' ? 'selected' }}>Completado</option>
                            <option value="canceled" {{ currentState == 'canceled' ? 'selected' }}>Cancelado</option>
                            <option value="all" {{ currentState == 'all' ? 'selected' }}>Todas las Citas</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex align-items-end gap-1">
                        <button type="submit" class="btn btn-primary" title="Filtrar">
                            <i class="bi bi-funnel-fill"></i>
                        </button>
                        <a href="{{ path('app_citas_index_list') }}" class="btn btn-secondary" title="Limpiar">
                            <i class="bi bi-eraser-fill"></i>
                        </a>
                        <button type="submit" name="export" value="pdf" class="btn btn-outline-danger" formtarget="_blank" title="Exportar a PDF" data-controller="confirm-action" data-action="click->confirm-action#confirm" data-confirm-action-title-value="¿Generar Reporte PDF?" data-confirm-action-text-value="Solo se permiten exportar reportes de máximo 1000 registros a la vez por motivos de rendimiento. ¿Desea continuar?" data-confirm-action-icon-value="info" data-confirm-action-confirm-text-value="Generar PDF">
                            <i class="bi bi-file-earmark-pdf-fill"></i> PDF
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card card-primary card-outline mb-4">
        <div class="card-header d-flex justify-content-between align-items-center"><h3 class="card-title m-0">Citas</h3><span class="text-muted small ms-auto"><i class="bi bi-info-circle"></i> Puedes buscar por <strong>Especialidad, Doctor, Consultorio o Paciente</strong></span></div>

        <div class="card-body">
            <div class="dtHereServer table-responsive" data-dt-config="{{ datatable_settings(datatable)|escape('html_attr') }}">Cargando registros...</div>
        </div>

        <div class="card-footer clearfix">
            {#<a href="{{ path('app_citas_configuraciones_new') }}" class="btn btn-primary btn-lg"><i class="bi bi-plus-circle-fill"></i> Nuevo</a>#}
        </div>
    </div>
{% endblock %}


