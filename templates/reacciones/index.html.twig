{% extends 'catalog/_base_index.html.twig' %}
{% import 'catalog/_actions.html.twig' as actions %}

{% set catalog_title = 'Reacciones' %}
{% set catalog_header_title = 'Reacciones Registradas' %}
{% set catalog_subtitle = 'Listado y administración de reacciones clínicas registradas en el sistema' %}
{% set catalog_icon = 'bi-activity' %}
{% set new_route = 'app_reacciones_new' %}

{% block table_head %}
    <th>Nombre</th>
    <th>Descripción</th>
{% endblock %}

{% block table_body %}
    {% for entity in entities %}
        <tr>
            <td class="fw-semibold">{{ entity.nombre }}</td>
            <td class="text-muted">{{ entity.descripcion|default('Sin descripción') }}</td>
            <td>
                {{ actions.row_actions(
                    path('app_reacciones_show', {'id': entity.id}),
                    path('app_reacciones_edit', {'id': entity.id}),
                    path('app_reacciones_delete', {'id': entity.id}),
                    entity.id
                ) }}
            </td>
        </tr>
    {% endfor %}
{% endblock %}
