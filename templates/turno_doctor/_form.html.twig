{{ form_start(form, {
    'attr': {
        'data-controller': 'submit-once cascading-doctor shift-validator',
        'data-action': 'submit->submit-once#disable',
        'data-shift-validator-api-url-value': path('app_turno_doctor_validate_conflict'),
        'data-shift-validator-exclude-id-value': form.vars.data.id|default('')
    }
}) }}
{{ include('base/_form_error_messages.html.twig') }}
<div class="card-body">
    <h5>Configurar Parametros de Turno:</h5>

    <div class="alert d-none mb-3" role="alert" data-shift-validator-target="feedbackContainer">
        <span data-shift-validator-target="feedbackText"></span>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                {{form_label( form.especialidad ) }}
                <div class="input-group">
                    {{form_widget( form.especialidad ) }}
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="mb-3">
                {{form_label( form.doctor ) }}
                <div class="input-group">
                    {{form_widget( form.doctor, { 'attr': {
                        'data-shift-validator-target': 'doctor',
                        'data-action': 'change->shift-validator#calculate'
                    } } ) }}
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-2">
            <div class="mb-2">
                {{form_label( form.dayOfWeek ) }}
                <div class="input-group">
                    {{form_widget( form.dayOfWeek, { 'attr': {
                        'data-shift-validator-target': 'dayOfWeek',
                        'data-action': 'change->shift-validator#calculate'
                    } } ) }}
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                {{form_label( form.startTime ) }}
                <div class="input-group">
                    {{form_widget( form.startTime, { 'attr': {
                        'data-shift-validator-target': 'startTime',
                        'data-action': 'change->shift-validator#calculate'
                    } } ) }}
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                {{form_label( form.endTime ) }}
                <div class="input-group">
                    {{form_widget( form.endTime, { 'attr': {
                        'data-shift-validator-target': 'endTime',
                        'data-action': 'change->shift-validator#calculate'
                    } } ) }}
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mb-4">
                {{form_label( form.consultorio ) }}
                <div class="input-group">
                    {{form_widget( form.consultorio, { 'attr': {
                        'data-shift-validator-target': 'consultorio',
                        'data-action': 'change->shift-validator#calculate'
                    } } ) }}
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card-footer">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between">
                <a class="btn btn-primary" href="{{ path('app_turno_doctor_index') }}">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>

                <div class="d-flex">
                    <button type="submit" class="btn btn-success" data-submit-once-target="submitButton" data-shift-validator-target="submitButton">
                        {{ button_label|default('Guardar') }}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{{ form_end(form) }}
