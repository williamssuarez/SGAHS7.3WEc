{% extends 'base.html.twig' %}

{% block title %}Editar Configuración de Turno{% endblock %}

{% block titlewrap %}
    Editar Configuración de Turno
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_turno_doctor_index') }}">Configuraciones de Turnos</a></li>
    <li class="breadcrumb-item active" aria-current="page">Editar Turno</li>
{% endblock %}

{% block body %}
<div class="apple-portal-container">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">
            <div class="apple-table-card apple-form-card shadow-sm mb-4">
                <div class="apple-table-header d-flex flex-wrap align-items-center justify-content-between gap-3 pb-3 mb-4 border-bottom border-secondary-subtle">
                    <div class="d-flex align-items-center gap-3 min-width-0">
                        <div class="apple-header-icon-badge" aria-hidden="true">
                            <i class="bi bi-pencil-square"></i>
                        </div>
                        <div class="min-width-0">
                            <h3 class="apple-table-title m-0">Editar Turno #{{ turno_doctor.id }}</h3>
                            <p class="apple-table-subtitle text-muted small m-0">
                                {{ turno_doctor.doctor.nombre }} {{ turno_doctor.doctor.apellido }} · {{ turno_doctor.especialidad.nombre }}
                            </p>
                        </div>
                    </div>

                    <span class="apple-role-pill {{ turno_doctor.isActive ? 'text-bg-success' : 'text-bg-secondary' }} flex-shrink-0">
                        <i class="bi {{ turno_doctor.isActive ? 'bi-check-circle-fill' : 'bi-pause-circle-fill' }}" aria-hidden="true"></i>
                        <span>{{ turno_doctor.isActive ? 'Activo' : 'Inactivo' }}</span>
                    </span>
                </div>

                {{ include('turno_doctor/_form.html.twig', {'button_label': 'Guardar Cambios'}) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
