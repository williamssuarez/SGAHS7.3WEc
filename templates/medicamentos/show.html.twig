{% extends 'catalog/_base_show.html.twig' %}

{% set catalog_title = 'Medicamentos' %}
{% set catalog_singular = 'Medicamento' %}
{% set catalog_icon = 'bi-capsule' %}
{% set index_route = 'app_medicamentos_index' %}
{% set edit_route = 'app_medicamentos_edit' %}
{% set delete_route = 'app_medicamentos_delete' %}

{% block detail_content %}
    <div class="mb-3">
        <label class="text-secondary small fw-semibold text-uppercase d-block mb-1">Nombre Comercial</label>
        <div class="fs-5 fw-bold text-body">{{ entity.nombre }}</div>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-sm-6">
            <label class="text-secondary small fw-semibold text-uppercase d-block mb-1">Nombre Genérico</label>
            <div class="text-body fw-medium">{{ entity.nombreGenerico|default('No especificado') }}</div>
        </div>
        <div class="col-sm-6">
            <label class="text-secondary small fw-semibold text-uppercase d-block mb-1">Concentración</label>
            <div>
                <span class="apple-role-pill text-bg-secondary">
                    {{ entity.concentracion|default('No especificada') }}
                </span>
            </div>
        </div>
    </div>
    <div class="mb-2">
        <label class="text-secondary small fw-semibold text-uppercase d-block mb-1">Descripción</label>
        <div class="text-body">{{ entity.descripcion|default('Sin descripción registrada') }}</div>
    </div>
{% endblock %}
