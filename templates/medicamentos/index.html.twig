{% extends 'catalog/_base_index.html.twig' %}
{% import 'catalog/_actions.html.twig' as actions %}

{% set catalog_title = 'Medicamentos' %}
{% set catalog_header_title = 'Medicamentos Registrados' %}
{% set catalog_subtitle = 'Listado y administración de medicamentos, principios activos y concentraciones' %}
{% set catalog_icon = 'bi-capsule' %}
{% set new_route = 'app_medicamentos_new' %}

{% block table_head %}
    <th>Nombre Comercial</th>
    <th>Nombre Genérico</th>
    <th>Concentración</th>
    <th>Descripción</th>
{% endblock %}

{% block table_body %}
    {% for entity in entities %}
        <tr>
            <td class="fw-semibold">{{ entity.nombre }}</td>
            <td>{{ entity.nombreGenerico|default('N/A') }}</td>
            <td>
                <span class="apple-role-pill text-bg-secondary">
                    {{ entity.concentracion|default('N/A') }}
                </span>
            </td>
            <td class="text-muted">{{ entity.descripcion|default('Sin descripción') }}</td>
            <td>
                {{ actions.row_actions(
                    path('app_medicamentos_show', {'id': entity.id}),
                    path('app_medicamentos_edit', {'id': entity.id}),
                    path('app_medicamentos_delete', {'id': entity.id}),
                    entity.id
                ) }}
            </td>
        </tr>
    {% endfor %}
{% endblock %}
