{% extends 'base.html.twig' %}

{% block title %}{{ form_title|default('Formulario') }}{% endblock %}

{% block titlewrap %}
    {{ form_title|default('Formulario') }}
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path(index_route) }}">{{ catalog_title|default('Catálogo') }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ form_title|default('Formulario') }}</li>
{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 mx-auto">
            <div class="apple-table-card apple-form-card shadow-sm mb-4">
                <div class="apple-table-header d-flex align-items-center gap-3 pb-3 mb-3 border-bottom">
                    <div class="apple-header-icon-badge">
                        <i class="bi {{ catalog_icon|default('bi-pencil-square') }}"></i>
                    </div>
                    <div>
                        <h3 class="apple-table-title m-0">{{ form_title|default('Formulario') }}</h3>
                        <p class="apple-table-subtitle text-muted small m-0">
                            {{ form_subtitle|default('Complete la información requerida a continuación') }}
                        </p>
                    </div>
                </div>

                <div class="apple-table-body pt-1">
                    {% block form_content %}{% endblock %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
