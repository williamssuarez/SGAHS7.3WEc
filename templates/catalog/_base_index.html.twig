{% extends 'base.html.twig' %}

{% block title %}{{ catalog_title|default('Catálogo') }}{% endblock %}

{% block titlewrap %}
    {{ catalog_title|default('Catálogo') }}
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">{{ catalog_title|default('Catálogo') }}</li>
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="apple-alert apple-alert-{{ label == 'error' or label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} alert-dismissible fade show mb-4" role="alert">
                <i class="bi {{ label == 'error' or label == 'danger' ? 'bi-exclamation-octagon-fill' : (label == 'warning' ? 'bi-exclamation-triangle-fill' : 'bi-check-circle-fill') }} me-2"></i>
                <span>{{ message }}</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="apple-table-card shadow-sm mb-4">
        <div class="apple-table-header d-flex flex-wrap justify-content-between align-items-center gap-3 pb-3 mb-3 border-bottom">
            <div class="d-flex align-items-center gap-3">
                <div class="apple-header-icon-badge">
                    <i class="bi {{ catalog_icon|default('bi-collection') }}"></i>
                </div>
                <div>
                    <h3 class="apple-table-title m-0">{{ catalog_header_title|default((catalog_title|default('Catálogo')) ~ ' Registrados') }}</h3>
                    <p class="apple-table-subtitle text-muted small m-0">
                        <i class="bi bi-info-circle me-1"></i> {{ catalog_subtitle|default('Administración y consulta de registros activos') }}
                    </p>
                </div>
            </div>

            {% if new_route is defined and new_route %}
                <div class="d-flex align-items-center ms-auto">
                    <a href="{{ path(new_route) }}" class="btn btn-primary apple-btn-primary rounded-pill px-4 py-2 d-inline-flex align-items-center gap-2" data-controller="apple-spring">
                        <i class="bi bi-plus-lg"></i>
                        <span>Nuevo</span>
                    </a>
                </div>
            {% endif %}
        </div>

        <div class="apple-table-body">
            <div class="table-responsive">
                <table class="table table-striped dtHere align-middle w-100">
                    <thead>
                        <tr>
                            {% block table_head %}{% endblock %}
                            <th class="text-end text-nowrap" style="width: 130px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% block table_body %}{% endblock %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
