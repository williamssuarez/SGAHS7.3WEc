{% extends 'catalog/_base_index.html.twig' %}
{% import 'catalog/_actions.html.twig' as actions %}

{% set catalog_title = 'Discapacidades' %}
{% set catalog_header_title = 'Discapacidades Registradas' %}
{% set catalog_subtitle = 'Listado y clasificación de discapacidades registradas en el sistema' %}
{% set catalog_icon = 'bi-person-wheelchair' %}
{% set new_route = 'app_discapacidades_new' %}

{% block table_head %}
    <th>Nombre</th>
    <th>Tipo</th>
    <th>Descripción</th>
{% endblock %}

{% block table_body %}
    {% for entity in entities %}
        <tr>
            <td class="fw-semibold">{{ entity.nombre }}</td>
            <td>
                {% set badge = entity.discapacidadesTiposBadgeConfig %}
                <span class="apple-role-pill {{ badge.class }}">
                    {{ badge.label }}
                </span>
            </td>
            <td class="text-muted">{{ entity.descripcion|default('Sin descripción') }}</td>
            <td>
                {{ actions.row_actions(
                    path('app_discapacidades_show', {'id': entity.id}),
                    path('app_discapacidades_edit', {'id': entity.id}),
                    path('app_discapacidades_delete', {'id': entity.id}),
                    entity.id
                ) }}
            </td>
        </tr>
    {% endfor %}
{% endblock %}
