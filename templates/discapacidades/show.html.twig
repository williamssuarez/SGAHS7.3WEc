{% extends 'catalog/_base_show.html.twig' %}

{% set catalog_title = 'Discapacidades' %}
{% set catalog_singular = 'Discapacidad' %}
{% set catalog_icon = 'bi-person-wheelchair' %}
{% set index_route = 'app_discapacidades_index' %}
{% set edit_route = 'app_discapacidades_edit' %}
{% set delete_route = 'app_discapacidades_delete' %}

{% block detail_content %}
    <div class="mb-3">
        <label class="text-secondary small fw-semibold text-uppercase d-block mb-1">Nombre</label>
        <div class="fs-5 fw-bold text-body">{{ entity.nombre }}</div>
    </div>
    <div class="mb-3">
        <label class="text-secondary small fw-semibold text-uppercase d-block mb-1">Tipo</label>
        <div>
            {% set badge = entity.discapacidadesTiposBadgeConfig %}
            <span class="apple-role-pill {{ badge.class }}">
                {{ badge.label }}
            </span>
        </div>
    </div>
    <div class="mb-2">
        <label class="text-secondary small fw-semibold text-uppercase d-block mb-1">Descripción</label>
        <div class="text-body">{{ entity.descripcion|default('Sin descripción registrada') }}</div>
    </div>
{% endblock %}
