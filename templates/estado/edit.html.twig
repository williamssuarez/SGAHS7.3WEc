{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_estado_index') }}">Estados</a></li>
    <li class="breadcrumb-item active" aria-current="page">Editar Estado {{ estado.nombre }}</li>
{% endblock %}

{% block body %}
