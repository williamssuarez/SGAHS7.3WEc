{% extends 'base.html.twig' %}

{% block title %}Detalle de Solicitud de Cita{% endblock %}

{% block titlewrap %}
    Detalle de Solicitud
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_citas_solicitudes_index') }}">Solicitudes</a></li>
    <li class="breadcrumb-item active" aria-current="page">Detalles</li>
{% endblock %}

{% block body %}
<div class="apple-portal-container">
    {# Mensajes Flash #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
            {# Tarjeta Estilo Pase Médico Digital / Apple Wallet #}
            <div class="apple-medical-pass">
                
                {# Cabecera Translúcida #}
                <div class="pass-header">
                    <div class="pass-title-row">
                        <div>
                            <div class="pass-specialty">
                                <i class="bi bi-heart-pulse-fill text-primary me-2"></i>
                                {{ entity.especialidad.nombre }}
                            </div>
                            <div class="pass-meta">
                                Solicitada el {{ entity.created|date('d/m/Y') }} &middot; <i>{{ entity.created|time_ago }}</i>
                            </div>
                        </div>

                        {# Badge de Estado de la Solicitud #}
                        <div>
                            {% set badge = entity.citasSolicitudesEstadosBadgeConfig %}
                            {% if entity.estadoSolicitud.value == 'pending' %}
                                <span class="apple-chip text-warning border-warning-subtle bg-warning-subtle fs-6 px-3 py-2">
                                    <i class="bi bi-hourglass-split"></i> {{ badge.label }}
                                </span>
                            {% elseif entity.estadoSolicitud.value == 'processing' %}
                                <span class="apple-chip chip-primary fs-6 px-3 py-2">
                                    <i class="bi bi-arrow-repeat"></i> {{ badge.label }}
                                </span>
                            {% elseif entity.estadoSolicitud.value == 'scheduled' %}
                                <span class="apple-chip text-success border-success-subtle bg-success-subtle fs-6 px-3 py-2">
                                    <i class="bi bi-check-circle-fill"></i> {{ badge.label }}
                                </span>
                            {% else %}
                                <span class="apple-chip chip-danger fs-6 px-3 py-2">
                                    <i class="bi bi-x-circle-fill"></i> {{ badge.label }}
                                </span>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {# Cuerpo del Pase #}
                <div class="pass-body">
                    {# Motivo de Consulta #}
                    <div class="mb-4">
                        <label class="apple-patient-meta d-block text-uppercase fw-bold small mb-2">
                            <i class="bi bi-chat-left-dots text-primary me-1"></i> Motivo de la Solicitud
                        </label>
                        <div class="p-3 bg-body-tertiary rounded-4 border border-opacity-10">
                            <p class="mb-0 fs-6 text-body lh-base">{{ entity.motivoConsulta }}</p>
                        </div>
                    </div>

                    {# Si la cita ya fue asignada: Mostrar el Ticket de Cita Médica #}
                    {% if cita %}
                        <div class="pass-divider"></div>

                        <div class="pass-appointment-ticket">
                            <div class="ticket-date-time">
                                <div class="ticket-date-block">
                                    <span class="ticket-label">
                                        <i class="bi bi-calendar-event me-1"></i> Fecha Programada
                                    </span>
                                    <div class="ticket-date-val text-body">
                                        {{ cita.fecha|date('d/m/Y', false) }}
                                    </div>
                                </div>

                                <div class="ticket-time-block">
                                    <i class="bi bi-clock-fill"></i>
                                    <span>{{ cita.horaInicio|date('H:i', false) }} - {{ cita.horaFin|date('H:i', false) }}</span>
                                </div>
                            </div>

                            <div class="ticket-details-grid">
                                <div class="ticket-item">
                                    <div class="ticket-item-icon">
                                        <i class="bi bi-person-badge"></i>
                                    </div>
                                    <div class="ticket-item-content">
                                        <span class="item-label">Médico Asignado</span>
                                        <span class="item-value text-body d-block">Dr(a). {{ cita.doctor.nombre }} {{ cita.doctor.apellido }}</span>
                                        <span class="item-sub">Especialista en {{ entity.especialidad.nombre }}</span>
                                    </div>
                                </div>

                                <div class="ticket-item">
                                    <div class="ticket-item-icon">
                                        <i class="bi bi-geo-alt-fill"></i>
                                    </div>
                                    <div class="ticket-item-content">
                                        <span class="item-label">Consultorio y Ubicación</span>
                                        <span class="item-value text-body d-block">Consultorio {{ cita.consultorio.nombre }}</span>
                                        <span class="item-sub">{{ cita.consultorio.ubicacion }}</span>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap align-items-center justify-content-between pt-3 mt-3 border-top border-success-subtle">
                                <span class="small text-secondary">
                                    <i class="bi bi-shield-check text-success me-1"></i> Estado: <strong>{{ cita.estadoCita.readableText }}</strong>
                                </span>

                                {% if cita.estadoCita.value == 'expected' %}
                                    <a href="{{ path('app_citas_solicitudes_voucher', {'uuid': entity.uuid}) }}" 
                                       target="_blank"
                                       class="apple-btn btn-apple-voucher mt-2 mt-sm-0" 
                                       data-controller="apple-spring">
                                        <i class="bi bi-file-earmark-pdf-fill"></i>
                                        <span>Descargar Comprobante</span>
                                    </a>
                                {% endif %}
                            </div>
                        </div>

                    {# Si aún está pendiente #}
                    {% elseif entity.estadoSolicitud.value in ['pending', 'processing'] %}
                        <div class="pass-pending-banner">
                            <div class="pending-icon-bubble">
                                <i class="bi bi-hourglass-top"></i>
                            </div>
                            <div class="pending-content">
                                <h5 class="pending-title">Solicitud en cola de asignación</h5>
                                <p class="pending-desc">
                                    Tu requerimiento médico está siendo revisado por nuestro departamento de admisión y programación. En cuanto se asigne el médico especialista y el consultorio, recibirás tu confirmación con fecha y comprobante aquí mismo.
                                </p>
                            </div>
                        </div>

                    {# Si fue cancelada o rechazada #}
                    {% elseif entity.estadoSolicitud.value in ['canceled', 'rejected'] %}
                        <div class="alert alert-secondary border-0 rounded-4 p-3 d-flex align-items-center">
                            <i class="bi bi-info-circle-fill fs-4 text-secondary me-3"></i>
                            <div>
                                <strong>Solicitud inactiva:</strong> Esta solicitud fue finalizada sin asignación de cita médica. Puedes iniciar una nueva solicitud cuando lo requieras.
                            </div>
                        </div>
                    {% endif %}
                </div>

                {# Pie de Página con Acciones #}
                <div class="pass-footer">
                    <a href="{{ path('app_citas_solicitudes_index') }}" 
                       class="apple-btn btn-apple-secondary" 
                       data-controller="apple-spring">
                        <i class="bi bi-arrow-left"></i>
                        <span>Volver a Solicitudes</span>
                    </a>

                    {% if entity.estadoSolicitud.value == 'pending' %}
                        <a href="{{ path('app_citas_solicitudes_edit', {'uuid': entity.uuid}) }}" 
                           class="apple-btn btn-apple-primary" 
                           data-controller="apple-spring">
                            <i class="bi bi-pencil-square"></i>
                            <span>Editar Solicitud</span>
                        </a>
                    {% endif %}
                </div>

            </div>
        </div>
    </div>
</div>
{% endblock %}
