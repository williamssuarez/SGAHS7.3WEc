<div class="apple-form-card">
    <div class="form-header-group">
        <h3 class="form-header-title">
            <i class="bi bi-calendar-plus text-primary me-2"></i>
            {{ form_title|default('Información de la Solicitud') }}
        </h3>
        <p class="form-header-subtitle">
            Completa los siguientes campos para que el equipo médico y de admisión pueda programar tu cita según la disponibilidad hospitalaria.
        </p>
    </div>

    {{ form_start(form, {
        'attr': {
            'data-controller': 'submit-once',
            'data-action': 'submit->submit-once#disable'
        }
    }) }}

    {{ include('base/_form_error_messages.html.twig') }}

    <div class="apple-form-group">
        <label for="{{ form.especialidad.vars.id }}" class="apple-field-label">
            <i class="bi bi-hospital"></i>
            {{ form_label(form.especialidad) }}
        </label>
        <div>
            {{ form_widget(form.especialidad) }}
        </div>
        <div class="form-text mt-1 text-secondary small">
            Selecciona el servicio médico o especialidad correspondiente a tu necesidad de atención.
        </div>
        {{ form_errors(form.especialidad) }}
    </div>

    <div class="apple-form-group">
        <label for="{{ form.motivoConsulta.vars.id }}" class="apple-field-label">
            <i class="bi bi-chat-square-text"></i>
            {{ form_label(form.motivoConsulta) }}
        </label>
        <div>
            {{ form_widget(form.motivoConsulta) }}
        </div>
        <div class="form-text mt-1 text-secondary small">
            Describe brevemente tus síntomas, tiempo de evolución o si acudes por control o derivación.
        </div>
        {{ form_errors(form.motivoConsulta) }}
    </div>

    <div class="apple-form-actions">
        <a href="{{ path('app_citas_solicitudes_index') }}" 
           class="apple-btn btn-apple-secondary" 
           data-controller="apple-spring">
            <i class="bi bi-arrow-left"></i>
            <span>Cancelar</span>
        </a>

        <button type="submit" 
                class="apple-btn btn-apple-primary" 
                data-controller="apple-spring" 
                data-submit-once-target="submitButton">
            <i class="bi bi-check-circle-fill"></i>
            <span>{{ button_label|default('Guardar Solicitud') }}</span>
        </button>
    </div>

    {{ form_end(form) }}
</div>
