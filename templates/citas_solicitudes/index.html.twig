{% extends 'base.html.twig' %}

{% block title %}Solicitudes de Citas{% endblock %}

{% block titlewrap %}
    Mis Citas Médicas
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">Solicitudes de Citas</li>
{% endblock %}

{% block body %}
<div class="apple-portal-container" data-controller="apple-citas-filter">
    {# Alertas Flash estilizadas al estilo Apple #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {# Aviso de cuenta inactiva por fallecimiento #}
    {% if paciente and paciente.fallecido %}
        <div class="alert alert-warning border-0 rounded-4 shadow-sm d-flex align-items-center p-3 mb-4">
            <i class="bi bi-exclamation-triangle-fill fs-4 text-warning me-3 flex-shrink-0"></i>
            <div>
                <strong>Aviso de seguridad:</strong> El titular de esta cuenta fue registrado como fallecido. Podrá consultar el histórico de solicitudes, pero la creación de nuevas citas médicas se encuentra inactiva.
            </div>
        </div>
    {% endif %}

    {# Cabecera de la Página #}
    <div class="apple-page-header">
        <div class="header-title-group">
            <h1 class="page-title">Solicitudes de Citas</h1>
            <p class="page-subtitle">Gestiona tus requerimientos de atención médica y consulta las fechas asignadas por el hospital.</p>
        </div>

        {% if not paciente or not paciente.fallecido %}
            <div>
                <a href="{{ path('app_citas_solicitudes_new') }}" 
                   class="apple-btn btn-apple-primary shadow-sm" 
                   data-controller="apple-spring">
                    <i class="bi bi-plus-circle-fill fs-5"></i>
                    <span>Nueva Solicitud</span>
                </a>
            </div>
        {% endif %}
    </div>

    {% if entities is not empty %}
        {# Segmented Control de Filtrado #}
        <div class="apple-segmented-bar-wrapper" data-controller="apple-segmented">
            <button type="button" class="apple-scroll-btn apple-scroll-btn-left" data-apple-segmented-target="prevBtn" aria-label="Desplazar a la izquierda">
                <i class="bi bi-chevron-left"></i>
            </button>

            <div class="apple-segmented-bar" data-apple-segmented-target="bar" role="tablist">
                <button type="button"
                        class="apple-segmented-item active"
                        data-filter="all"
                        data-apple-citas-filter-target="button"
                        data-action="click->apple-citas-filter#select"
                        role="tab"
                        aria-selected="true">
                    <i class="bi bi-grid-fill"></i>
                    <span>Todas ({{ entities|length }})</span>
                </button>

                {% set pendingCount = 0 %}
                {% set scheduledCount = 0 %}
                {% set canceledCount = 0 %}
                {% for entity in entities %}
                    {% if entity.estadoSolicitud.value in ['pending', 'processing'] %}
                        {% set pendingCount = pendingCount + 1 %}
                    {% elseif entity.estadoSolicitud.value == 'scheduled' %}
                        {% set scheduledCount = scheduledCount + 1 %}
                    {% elseif entity.estadoSolicitud.value in ['canceled', 'rejected'] %}
                        {% set canceledCount = canceledCount + 1 %}
                    {% endif %}
                {% endfor %}

                <button type="button"
                        class="apple-segmented-item"
                        data-filter="pending"
                        data-apple-citas-filter-target="button"
                        data-action="click->apple-citas-filter#select"
                        role="tab"
                        aria-selected="false">
                    <i class="bi bi-hourglass-split text-warning"></i>
                    <span>Pendientes ({{ pendingCount }})</span>
                </button>

                <button type="button"
                        class="apple-segmented-item"
                        data-filter="scheduled"
                        data-apple-citas-filter-target="button"
                        data-action="click->apple-citas-filter#select"
                        role="tab"
                        aria-selected="false">
                    <i class="bi bi-calendar-check-fill text-success"></i>
                    <span>Confirmadas ({{ scheduledCount }})</span>
                </button>

                <button type="button"
                        class="apple-segmented-item"
                        data-filter="canceled"
                        data-apple-citas-filter-target="button"
                        data-action="click->apple-citas-filter#select"
                        role="tab"
                        aria-selected="false">
                    <i class="bi bi-archive-fill text-secondary"></i>
                    <span>Historial ({{ canceledCount }})</span>
                </button>
            </div>

            <button type="button" class="apple-scroll-btn apple-scroll-btn-right" data-apple-segmented-target="nextBtn" aria-label="Desplazar a la derecha">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>

        {# Cuadrícula de Tarjetas de Solicitudes #}
        <div class="apple-solicitud-grid" data-controller="auto-animate">
            {% for entity in entities %}
                {% set badge = entity.citasSolicitudesEstadosBadgeConfig %}
                <div class="apple-solicitud-card" 
                     data-apple-citas-filter-target="card" 
                     data-status="{{ entity.estadoSolicitud.value }}">
                    
                    {# Parte Superior: Icono de Especialidad + Estados #}
                    <div class="card-top">
                        <div class="specialty-info">
                            <div class="specialty-icon">
                                <i class="bi bi-heart-pulse-fill"></i>
                            </div>
                            <div>
                                <h3 class="specialty-name">{{ entity.especialidad.nombre }}</h3>
                                <div class="creation-date">
                                    <i class="bi bi-clock me-1"></i>
                                    {{ entity.created|date('d/m/Y') }} &middot; <i>{{ entity.created|time_ago }}</i>
                                </div>
                            </div>
                        </div>

                        {# Chip de Estado Apple #}
                        <div class="card-status-chip-wrap">
                            {% if entity.estadoSolicitud.value == 'pending' %}
                                <span class="apple-chip text-warning border-warning-subtle bg-warning-subtle">
                                    <i class="bi bi-hourglass-split"></i> {{ badge.label }}
                                </span>
                            {% elseif entity.estadoSolicitud.value == 'processing' %}
                                <span class="apple-chip chip-primary">
                                    <i class="bi bi-arrow-repeat"></i> {{ badge.label }}
                                </span>
                            {% elseif entity.estadoSolicitud.value == 'scheduled' %}
                                <span class="apple-chip text-success border-success-subtle bg-success-subtle">
                                    <i class="bi bi-check-circle-fill"></i> {{ badge.label }}
                                </span>
                            {% else %}
                                <span class="apple-chip chip-danger">
                                    <i class="bi bi-x-circle-fill"></i> {{ badge.label }}
                                </span>
                            {% endif %}
                        </div>
                    </div>

                    {# Motivo de Consulta #}
                    <div class="consultation-reason">
                        <span class="reason-label"><i class="bi bi-chat-left-text me-1"></i> Motivo de consulta</span>
                        <p class="reason-text">{{ entity.motivoConsulta }}</p>
                    </div>

                    {# Barra de Acciones #}
                    <div class="card-actions-bar">
                        <div class="card-actions-left">
                            <a href="{{ path('app_citas_solicitudes_show', {'uuid': entity.uuid}) }}" 
                               class="apple-btn btn-apple-secondary"
                               data-controller="apple-spring">
                                <i class="bi bi-eye"></i>
                                <span>Detalles</span>
                            </a>
                        </div>

                        <div class="card-actions-right">
                            {% if entity.estadoSolicitud.value == 'pending' %}
                                <a href="{{ path('app_citas_solicitudes_edit', {'uuid': entity.uuid}) }}" 
                                   class="apple-btn btn-apple-secondary" 
                                   title="Editar motivo"
                                   data-controller="apple-spring">
                                    <i class="bi bi-pencil-square"></i>
                                    <span>Editar</span>
                                </a>

                                <form action="{{ path('app_citas_solicitudes_cancelar', {'uuid': entity.uuid}) }}"
                                      method="POST"
                                      data-controller="confirm-finalizar"
                                      data-action="submit->confirm-finalizar#confirm"
                                      data-confirm-finalizar-title-value="¿Deseas cancelar esta solicitud?"
                                      data-confirm-finalizar-text-value="Una vez cancelada, no se te asignará fecha y deberás iniciar una nueva solicitud si aún requieres atención."
                                      data-confirm-finalizar-confirm-button-text-value="Sí, cancelar"
                                      class="m-0 p-0">
                                    <button type="submit" 
                                            class="apple-btn btn-apple-danger" 
                                            title="Cancelar Solicitud"
                                            data-controller="apple-spring">
                                        <i class="bi bi-trash3"></i>
                                        <span>Cancelar</span>
                                    </button>
                                </form>
                            {% elseif entity.estadoSolicitud.value == 'scheduled' %}
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                                    <i class="bi bi-calendar-event me-1"></i> Fecha asignada
                                </span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        {# Estado vacío cuando un filtro no arroja resultados #}
        <div data-apple-citas-filter-target="emptyNotice" class="apple-empty-state d-none">
            <div class="empty-icon-wrap">
                <i class="bi bi-calendar2-x"></i>
            </div>
            <h4 class="empty-title">Sin solicitudes en esta categoría</h4>
            <p class="empty-subtitle">No tienes solicitudes registradas bajo este estado actualmente.</p>
        </div>

    {% else %}
        {# Estado Vacío General (Sin solicitudes en absoluto) #}
        <div class="apple-empty-state">
            <div class="empty-icon-wrap">
                <i class="bi bi-calendar-heart"></i>
            </div>
            <h3 class="empty-title">Aún no tienes solicitudes de citas</h3>
            <p class="empty-subtitle">Cuando solicites una cita con nuestros especialistas médicos, podrás hacer seguimiento a su estado y descargar tu comprobante aquí.</p>
            {% if not paciente or not paciente.fallecido %}
                <a href="{{ path('app_citas_solicitudes_new') }}" 
                   class="apple-btn btn-apple-primary shadow-sm" 
                   data-controller="apple-spring">
                    <i class="bi bi-plus-lg"></i>
                    <span>Solicitar Mi Primera Cita</span>
                </a>
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}
