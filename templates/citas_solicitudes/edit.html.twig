{% extends 'base.html.twig' %}

{% block title %}Editar Solicitud de Cita{% endblock %}

{% block titlewrap %}
    Editar Solicitud de Cita
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_citas_solicitudes_index') }}">Solicitudes de Cita</a></li>
    <li class="breadcrumb-item active" aria-current="page">Editar Solicitud</li>
{% endblock %}

{% block body %}
<div class="apple-portal-container">
    {# Mensajes Flash #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
            {{ include('citas_solicitudes/_form.html.twig', {
                'form_title': 'Modificar Solicitud de Cita',
                'button_label': 'Guardar Cambios'
            }) }}
        </div>
    </div>
</div>
{% endblock %}
