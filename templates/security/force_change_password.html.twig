{% extends 'resetBase.html.twig' %}

{% block title %}Cambio de Clave Obligatorio{% endblock %}

{% block body %}
    <div class="alert alert-warning mb-4 shadow-sm border-warning">
        <h6 class="alert-heading fw-bold"><i class="bi bi-shield-exclamation me-2"></i>Acción Requerida</h6>
        <p class="mb-0 small">Por motivos de seguridad, debe establecer una nueva contraseña permanente antes de continuar utilizando el sistema.</p>
    </div>

    {{ form_start(changePasswordForm, {
        'attr': {
            'data-controller': 'submit-once',
            'data-action': 'submit->submit-once#disable'
        }
    }) }}
    
    {{ include('base/_form_error_messages.html.twig', {'form': changePasswordForm}, ignore_missing = true) }}
    
    {{ form_row(changePasswordForm.plainPassword) }}

    <br>

    <button type="submit" class="btn btn-warning fw-bold text-dark form-control shadow-sm" data-submit-once-target="submitButton">
        <i class="bi bi-check2-circle"></i> Guardar Nueva Clave
    </button>
    {{ form_end(changePasswordForm) }}
{% endblock %}
