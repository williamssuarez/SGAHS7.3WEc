{% extends 'resetBase.html.twig' %}

{% block title %}Cambio Obligatorio de Contraseña | SGAHS{% endblock %}

{% block card_title %}Cambio Obligatorio de Contraseña{% endblock %}
{% block card_desc %}Por motivos de seguridad, debes actualizar tu clave de acceso antes de continuar.{% endblock %}

{% block body %}
    {# Mensajes flash del sistema #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="apple-alert apple-alert-{{ label == 'error' or label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} mb-3" role="alert">
                <i class="bi bi-{{ label == 'error' or label == 'danger' ? 'exclamation-octagon-fill' : (label == 'warning' ? 'exclamation-triangle-fill' : 'check-circle-fill') }} flex-shrink-0"></i>
                <div>{{ message }}</div>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="apple-alert apple-alert-warning mb-3" role="alert">
        <i class="bi bi-shield-exclamation flex-shrink-0"></i>
        <div class="small">
            <strong>Acción Requerida:</strong> Por política institucional de seguridad o primer acceso, debes establecer una nueva contraseña permanente.
        </div>
    </div>

    <div class="apple-alert apple-alert-info mb-4" role="alert">
        <i class="bi bi-key-fill flex-shrink-0"></i>
        <div class="small">
            Tu nueva clave debe tener al menos <strong>12 caracteres</strong> y una complejidad media o superior para resguardar el historial clínico de los pacientes.
        </div>
    </div>

    {{ form_start(changePasswordForm, {
        'attr': {
            'class': 'apple-auth-form',
            'data-controller': 'submit-once',
            'data-action': 'submit->submit-once#disable',
            'data-submit-once-text-value': 'Guardando nueva clave...'
        }
    }) }}

        {{ include('base/_form_error_messages.html.twig', {'form': changePasswordForm}, ignore_missing = true) }}

        <div class="apple-form-group mb-3">
            <label for="{{ changePasswordForm.plainPassword.first.vars.id }}" class="apple-input-label">
                Nueva Contraseña <span class="text-danger">*</span>
            </label>
            <div class="apple-input-wrap" data-controller="password-toggle">
                <i class="bi bi-lock-fill apple-input-icon"></i>
                {{ form_widget(changePasswordForm.plainPassword.first, {
                    'attr': {
                        'class': 'apple-text-input',
                        'placeholder': 'Mínimo 12 caracteres...',
                        'data-password-toggle-target': 'input',
                        'autofocus': true
                    }
                }) }}
                <button type="button" 
                        class="apple-input-action-btn" 
                        data-action="click->password-toggle#toggle"
                        tabindex="-1"
                        aria-label="Mostrar u ocultar contraseña">
                    <i class="bi bi-eye-fill" data-password-toggle-target="icon"></i>
                </button>
            </div>
            {% if form_errors(changePasswordForm.plainPassword.first) %}
                <div class="apple-field-error">{{ form_errors(changePasswordForm.plainPassword.first) }}</div>
            {% endif %}
        </div>

        <div class="apple-form-group mb-4">
            <label for="{{ changePasswordForm.plainPassword.second.vars.id }}" class="apple-input-label">
                Confirmar Nueva Contraseña <span class="text-danger">*</span>
            </label>
            <div class="apple-input-wrap" data-controller="password-toggle">
                <i class="bi bi-shield-lock-fill apple-input-icon"></i>
                {{ form_widget(changePasswordForm.plainPassword.second, {
                    'attr': {
                        'class': 'apple-text-input',
                        'placeholder': 'Repite tu nueva contraseña...',
                        'data-password-toggle-target': 'input'
                    }
                }) }}
                <button type="button" 
                        class="apple-input-action-btn" 
                        data-action="click->password-toggle#toggle"
                        tabindex="-1"
                        aria-label="Mostrar u ocultar contraseña">
                    <i class="bi bi-eye-fill" data-password-toggle-target="icon"></i>
                </button>
            </div>
            {% if form_errors(changePasswordForm.plainPassword.second) %}
                <div class="apple-field-error">{{ form_errors(changePasswordForm.plainPassword.second) }}</div>
            {% endif %}
        </div>

        <button type="submit" 
                class="apple-btn btn-apple-primary btn-apple-lg w-100 mt-2" 
                data-submit-once-target="submitButton"
                data-controller="apple-spring">
            <i class="bi bi-check2-circle"></i>
            <span>Guardar Nueva Contraseña</span>
        </button>

    {{ form_end(changePasswordForm) }}
{% endblock %}

{% block auth_footer %}
    <div class="apple-auth-links">
        <a href="{{ path('app_logout') }}" class="apple-auth-link">
            <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
        </a>
    </div>
{% endblock %}
