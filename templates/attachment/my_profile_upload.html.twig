{% extends 'base.html.twig' %}

{% block title %}Subir Archivo | {{ paciente.nombre|title }}{% endblock %}

{% block titlewrap %}
    Subir Archivo para {{ paciente.nombre|title }} {{ paciente.apellido|title }}
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('my_profile_show', {'uuid': app.user.externalProfile.uuid}) }}">Mi Perfil</a></li>
    <li class="breadcrumb-item active" aria-current="page">Subir Archivo</li>
{% endblock %}

{% block body %}
<div class="apple-portal-container">
    {# Mensajes Flash #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
            {{ include('attachment/_formExtUser.html.twig', {
                'form_title': 'Adjuntar Documento al Expediente',
                'button_label': 'Subir Archivo'
            }) }}
        </div>
    </div>
</div>
{% endblock %}
