{% extends 'resetBase.html.twig' %}

{% block title %}Cuenta Suspendida | SGAHS{% endblock %}

{% block card_title %}Acceso Restringido{% endblock %}
{% block card_desc %}El acceso a esta cuenta ha sido bloqueado administrativamente.{% endblock %}

{% block body %}
    <div class="apple-alert apple-alert-danger mb-4" role="alert">
        <i class="bi bi-shield-slash-fill flex-shrink-0"></i>
        <div>
            <strong class="d-block mb-1">Tu cuenta se encuentra suspendida</strong>
            Por motivos de seguridad, cumplimiento normativo o auditoría interna, un administrador ha inhabilitado el acceso a esta cuenta.
        </div>
    </div>

    <div class="apple-alert apple-alert-warning mb-4" role="alert">
        <i class="bi bi-info-circle-fill flex-shrink-0"></i>
        <div>
            <strong class="d-block mb-1">¿Cómo solucionar esta restricción?</strong>
            Debes presentarte personalmente en el área de <strong>Admisión / Atención al Usuario</strong> con tu Cédula de Identidad física y laminada para validar tus datos y solicitar el desbloqueo con el personal autorizado.
        </div>
    </div>

    <div class="mt-4 pt-2">
        <a href="{{ path('app_logout') }}" 
           class="apple-btn btn-apple-secondary btn-apple-lg w-100" 
           data-controller="apple-spring">
            <i class="bi bi-box-arrow-right"></i>
            <span>Cerrar Sesión</span>
        </a>
    </div>
{% endblock %}

{% block auth_footer %}
    <div class="apple-auth-links">
        <span class="text-muted small">
            <i class="bi bi-shield-lock me-1"></i> SGAHS · Departamento de Seguridad y Control de Acceso
        </span>
    </div>
{% endblock %}
