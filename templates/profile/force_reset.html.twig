{% extends 'resetBase.html.twig' %}

{% block title %}Credenciales Expiradas | SGAHS{% endblock %}

{% block card_title %}Credenciales Expiradas{% endblock %}
{% block card_desc %}Por motivos de seguridad, tus credenciales de acceso han caducado.{% endblock %}

{% block body %}
    <div class="apple-alert apple-alert-warning mb-3" role="alert">
        <i class="bi bi-shield-exclamation flex-shrink-0"></i>
        <div>
            <strong class="d-block mb-1">Actualización de clave requerida</strong>
            Un administrador o la política institucional de seguridad ha expirado las credenciales de esta cuenta. Ya no es posible iniciar sesión con la clave anterior.
        </div>
    </div>

    <div class="apple-alert apple-alert-info mb-3" role="alert">
        <i class="bi bi-envelope-check-fill flex-shrink-0"></i>
        <div>
            <strong class="d-block mb-1">Revisa tu correo electrónico</strong>
            Se ha generado un enlace de restablecimiento a tu dirección registrada. Por favor revisa tu bandeja de entrada y tu carpeta de <em>Spam</em> o <em>Correo no deseado</em>.
        </div>
    </div>

    <div class="apple-alert apple-alert-secondary mb-4" role="alert">
        <i class="bi bi-question-circle-fill flex-shrink-0"></i>
        <div>
            <strong class="d-block mb-1">¿No recibiste el correo?</strong>
            Puedes solicitar un nuevo enlace de recuperación directamente con el botón a continuación.
        </div>
    </div>

    <div class="d-flex flex-column gap-2 mt-4">
        <a href="{{ path('app_forgot_password_manually_request') }}" 
           class="apple-btn btn-apple-primary btn-apple-lg w-100" 
           data-controller="apple-spring">
            <i class="bi bi-send-fill"></i>
            <span>Solicitar Nuevo Enlace</span>
        </a>

        <a href="{{ path('app_logout') }}" 
           class="apple-btn btn-apple-secondary btn-apple-lg w-100" 
           data-controller="apple-spring">
            <i class="bi bi-box-arrow-right"></i>
            <span>Cerrar Sesión</span>
        </a>
    </div>
{% endblock %}

{% block auth_footer %}
    <div class="apple-auth-links">
        <a href="{{ path('app_login') }}" class="apple-auth-link">
            <i class="bi bi-arrow-left me-1"></i> Ir al inicio de sesión
        </a>
    </div>
{% endblock %}
