{% extends 'resetBase.html.twig' %}

{% block title %}Correo Enviado | SGAHS{% endblock %}

{% block auth_card %}
    <!-- Distintivo de Correo Central -->
    <div class="text-center mb-3">
        <div class="apple-inbox-badge mx-auto">
            <i class="bi bi-envelope-check-fill"></i>
        </div>
    </div>

    <div class="apple-auth-card-header text-center mb-3">
        <h2 class="apple-auth-card-title">Revisa tu Bandeja de Entrada</h2>
        <p class="apple-auth-card-desc">
            Si existe una cuenta activa asociada a ese correo electrónico, acabamos de enviar un enlace seguro para restablecer tu contraseña.
        </p>
    </div>

    <!-- Chip con Tiempo de Expiración -->
    <div class="text-center mb-4">
        <div class="apple-timer-pill">
            <i class="bi bi-clock-history me-1 text-primary"></i>
            <span>Este enlace expirará en <strong>{{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}</strong></span>
        </div>
    </div>

    <!-- Mensajes Flash del Sistema si existieran -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="apple-alert apple-alert-{{ label == 'error' ? 'danger' : (label == 'success' ? 'success' : 'info') }} mb-3" role="alert">
                <i class="bi bi-{{ label == 'error' ? 'exclamation-circle-fill' : (label == 'success' ? 'check-circle-fill' : 'info-circle-fill') }} flex-shrink-0"></i>
                <div>{{ message }}</div>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Nota Informativa de Spam -->
    <div class="apple-alert apple-alert-info mb-4" role="alert">
        <i class="bi bi-info-circle-fill flex-shrink-0"></i>
        <div>
            <strong>¿No ves el correo?</strong><br>
            Asegúrate de revisar tu carpeta de Spam o correo no deseado. Si no llega en unos minutos, puedes intentar solicitarlo nuevamente.
        </div>
    </div>

    <!-- Acciones de Navegación -->
    <div class="d-flex flex-column gap-2">
        <a href="{{ path('app_login') }}" 
           class="apple-btn btn-apple-primary btn-apple-lg w-100" 
           data-controller="apple-spring">
            <i class="bi bi-box-arrow-in-right"></i>
            <span>Volver al Inicio de Sesión</span>
        </a>

        <a href="{{ path('app_forgot_password_request') }}" 
           class="apple-auth-link text-center mt-2">
            <i class="bi bi-arrow-repeat me-1"></i> Intentar solicitarlo nuevamente
        </a>
    </div>
{% endblock %}
