{% extends 'resetBase.html.twig' %}

{% block title %}Restablecer Contraseña | SGAHS{% endblock %}

{% block card_title %}Crea tu Nueva Contraseña{% endblock %}
{% block card_desc %}Ingresa una contraseña segura de al menos 12 caracteres.{% endblock %}

{% block body %}
    {# Errores flash del sistema #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="apple-alert apple-alert-{{ label == 'error' ? 'danger' : (label == 'success' ? 'success' : 'info') }} mb-3" role="alert">
                <i class="bi bi-{{ label == 'error' ? 'exclamation-circle-fill' : (label == 'success' ? 'check-circle-fill' : 'info-circle-fill') }} flex-shrink-0"></i>
                <div>{{ message }}</div>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="apple-alert apple-alert-info mb-4" role="alert">
        <i class="bi bi-shield-check flex-shrink-0"></i>
        <div class="small">
            Tu nueva clave debe tener al menos <strong>12 caracteres</strong> y una complejidad media o superior para proteger tu historial médico.
        </div>
    </div>

    {{ form_start(form, {
        'attr': {
            'class': 'apple-auth-form',
            'data-controller': 'submit-once',
            'data-action': 'submit->submit-once#disable',
            'data-submit-once-text-value': 'Guardando contraseña...'
        }
    }) }}

        <div class="apple-form-group mb-3">
            <label for="{{ form.plainPassword.first.vars.id }}" class="apple-input-label">
                Nueva Contraseña <span class="text-danger">*</span>
            </label>
            <div class="apple-input-wrap" data-controller="password-toggle">
                <i class="bi bi-lock-fill apple-input-icon"></i>
                {{ form_widget(form.plainPassword.first, {
                    'attr': {
                        'class': 'apple-text-input',
                        'placeholder': 'Mínimo 12 caracteres...',
                        'data-password-toggle-target': 'input',
                        'autofocus': true
                    }
                }) }}
                <button type="button" 
                        class="apple-input-action-btn" 
                        data-action="click->password-toggle#toggle"
                        tabindex="-1"
                        aria-label="Mostrar u ocultar contraseña">
                    <i class="bi bi-eye-fill" data-password-toggle-target="icon"></i>
                </button>
            </div>
            {% if form_errors(form.plainPassword.first) %}
                <div class="apple-field-error">{{ form_errors(form.plainPassword.first) }}</div>
            {% endif %}
        </div>

        <div class="apple-form-group mb-4">
            <label for="{{ form.plainPassword.second.vars.id }}" class="apple-input-label">
                Confirmar Nueva Contraseña <span class="text-danger">*</span>
            </label>
            <div class="apple-input-wrap" data-controller="password-toggle">
                <i class="bi bi-shield-lock-fill apple-input-icon"></i>
                {{ form_widget(form.plainPassword.second, {
                    'attr': {
                        'class': 'apple-text-input',
                        'placeholder': 'Repite tu nueva contraseña...',
                        'data-password-toggle-target': 'input'
                    }
                }) }}
                <button type="button" 
                        class="apple-input-action-btn" 
                        data-action="click->password-toggle#toggle"
                        tabindex="-1"
                        aria-label="Mostrar u ocultar contraseña">
                    <i class="bi bi-eye-fill" data-password-toggle-target="icon"></i>
                </button>
            </div>
            {% if form_errors(form.plainPassword.second) %}
                <div class="apple-field-error">{{ form_errors(form.plainPassword.second) }}</div>
            {% endif %}
        </div>

        <button type="submit" 
                class="apple-btn btn-apple-primary btn-apple-lg w-100 mt-2" 
                data-submit-once-target="submitButton"
                data-controller="apple-spring">
            <i class="bi bi-check2-circle"></i>
            <span>{{ button_label|default('Restablecer Contraseña') }}</span>
        </button>

    {{ form_end(form) }}
{% endblock %}

{% block auth_footer %}
    <div class="apple-auth-links">
        <a href="{{ path('app_login') }}" class="apple-auth-link">
            <i class="bi bi-arrow-left me-1"></i> Volver al inicio de sesión
        </a>
    </div>
{% endblock %}
