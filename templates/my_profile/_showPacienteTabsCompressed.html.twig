<div class="apple-tabs-module">
    <!-- Apple Segmented Bar (Fluid Touch & Desktop Drag/Wheel Scroll) -->
    <div class="apple-segmented-bar-wrapper" data-controller="apple-segmented">
        <button type="button" class="apple-scroll-btn apple-scroll-btn-left" data-apple-segmented-target="prevBtn" data-action="click->apple-segmented#scrollPrev" aria-label="Desplazar a la izquierda">
            <i class="bi bi-chevron-left"></i>
        </button>

        <div class="apple-segmented-bar" role="tablist" data-apple-segmented-target="bar">
            <button class="apple-segmented-item active" id="tabVitales" data-bs-toggle="tab" data-bs-target="#tabVitales-pane" type="button" role="tab" aria-controls="tabVitales-pane" aria-selected="true" data-controller="apple-spring">
                <i class="bi bi-heart-pulse-fill text-danger"></i>
                <span>Signos Vitales</span>
            </button>

            <button class="apple-segmented-item" id="tabMedicaciones" data-bs-toggle="tab" data-bs-target="#tabMedicaciones-pane" type="button" role="tab" aria-controls="tabMedicaciones-pane" aria-selected="false" data-controller="apple-spring">
                <i class="bi bi-capsule-pill text-primary"></i>
                <span>Medicaciones</span>
            </button>

            <button class="apple-segmented-item" id="tabAlergias" data-bs-toggle="tab" data-bs-target="#tabAlergias-pane" type="button" role="tab" aria-controls="tabAlergias-pane" aria-selected="false" data-controller="apple-spring">
                <i class="bi bi-virus text-warning"></i>
                <span>Alergias</span>
            </button>

            <button class="apple-segmented-item" id="tabCondiciones" data-bs-toggle="tab" data-bs-target="#tabCondiciones-pane" type="button" role="tab" aria-controls="tabCondiciones-pane" aria-selected="false" data-controller="apple-spring">
                <i class="fa fa-person-cane text-info"></i>
                <span>Condiciones</span>
            </button>

            <button class="apple-segmented-item" id="tabEnfermedades" data-bs-toggle="tab" data-bs-target="#tabEnfermedades-pane" type="button" role="tab" aria-controls="tabEnfermedades-pane" aria-selected="false" data-controller="apple-spring">
                <i class="fa-solid fa-head-side-cough text-secondary"></i>
                <span>Enfermedades</span>
            </button>

            <button class="apple-segmented-item" id="tabDiscapacidades" data-bs-toggle="tab" data-bs-target="#tabDiscapacidades-pane" type="button" role="tab" aria-controls="tabDiscapacidades-pane" aria-selected="false" data-controller="apple-spring">
                <i class="bi bi-person-wheelchair text-success"></i>
                <span>Discapacidades</span>
            </button>

            <button class="apple-segmented-item" id="tabInmunizaciones" data-bs-toggle="tab" data-bs-target="#tabInmunizaciones-pane" type="button" role="tab" aria-controls="tabInmunizaciones-pane" aria-selected="false" data-controller="apple-spring">
                <i class="fa-solid fa-syringe text-danger"></i>
                <span>Vacunas</span>
            </button>

            <button class="apple-segmented-item" id="tabArchivos" data-bs-toggle="tab" data-bs-target="#tabArchivos-pane" type="button" role="tab" aria-controls="tabArchivos-pane" aria-selected="false" data-controller="apple-spring">
                <i class="bi bi-folder-fill text-primary"></i>
                <span>Documentos</span>
            </button>

            <button class="apple-segmented-item" id="tabHistorial" data-bs-toggle="tab" data-bs-target="#tabHistorial-pane" type="button" role="tab" aria-controls="tabHistorial-pane" aria-selected="false" data-controller="apple-spring">
                <i class="bi bi-clock-history text-muted"></i>
                <span>Historial</span>
            </button>
        </div>

        <button type="button" class="apple-scroll-btn apple-scroll-btn-right" data-apple-segmented-target="nextBtn" data-action="click->apple-segmented#scrollNext" aria-label="Desplazar a la derecha">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>

    <!-- Contenido de Pestañas con Transición Suave AutoAnimate -->
    <div class="tab-content pt-2" id="formTabContent" data-controller="auto-animate">
        <div class="tab-pane fade show active" id="tabVitales-pane" role="tabpanel" aria-labelledby="tabVitales" tabindex="0">
            {{ include('my_profile/tabs/paciente_vitales.html.twig') }}
        </div>
        <div class="tab-pane fade" id="tabMedicaciones-pane" role="tabpanel" aria-labelledby="tabMedicaciones" tabindex="0">
            {{ include('my_profile/tabs/paciente_prescripciones.html.twig') }}
        </div>
        <div class="tab-pane fade" id="tabAlergias-pane" role="tabpanel" aria-labelledby="tabAlergias" tabindex="0">
            {{ include('my_profile/tabs/paciente_alergias.html.twig') }}
        </div>
        <div class="tab-pane fade" id="tabCondiciones-pane" role="tabpanel" aria-labelledby="tabCondiciones" tabindex="0">
            {{ include('my_profile/tabs/paciente_condiciones.html.twig') }}
        </div>
        <div class="tab-pane fade" id="tabEnfermedades-pane" role="tabpanel" aria-labelledby="tabEnfermedades" tabindex="0">
            {{ include('my_profile/tabs/paciente_enfermedades.html.twig') }}
        </div>
        <div class="tab-pane fade" id="tabDiscapacidades-pane" role="tabpanel" aria-labelledby="tabDiscapacidades" tabindex="0">
            {{ include('my_profile/tabs/paciente_discapacidades.html.twig') }}
        </div>
        <div class="tab-pane fade" id="tabInmunizaciones-pane" role="tabpanel" aria-labelledby="tabInmunizaciones" tabindex="0">
            {{ include('my_profile/tabs/paciente_inmunizaciones.html.twig') }}
        </div>
        <div class="tab-pane fade" id="tabArchivos-pane" role="tabpanel" aria-labelledby="tabArchivos" tabindex="0">
            {{ include('my_profile/tabs/paciente_archivos.html.twig') }}
        </div>
        <div class="tab-pane fade" id="tabHistorial-pane" role="tabpanel" aria-labelledby="tabHistorial" tabindex="0">
            {{ include('my_profile/tabs/paciente_historial.html.twig') }}
        </div>
    </div>
</div>
