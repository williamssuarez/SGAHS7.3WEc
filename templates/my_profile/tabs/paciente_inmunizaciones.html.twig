<div class="apple-section">
    <div class="apple-section-header">
        <h5 class="text-body"><i class="fa-solid fa-syringe text-danger me-2"></i> Registro de Vacunas e Inmunizaciones</h5>
        <small class="text-secondary">Esquema preventivo</small>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle dtHere">
            <thead>
                <tr class="text-secondary small text-uppercase">
                    <th>#</th>
                    <th>Inmunización</th>
                    <th>Dosis</th>
                    <th>Sitio</th>
                    <th>Fabricante</th>
                    <th>Reacciones</th>
                    <th>Fecha Aplicación</th>
                </tr>
            </thead>
            <tbody>
            {% for entity in inmunizaciones %}
                <tr>
                    <td class="text-muted small">{{ loop.index }}</td>
                    <td class="fw-semibold text-primary">{{ entity.inmunizacion }}</td>
                    <td>
                        {% set badge = entity.pacienteInmunizacionesDosisBadgeConfig %}
                        <span class="apple-role-pill {{ badge.class }}">
                            {{ badge.label }}
                        </span>
                    </td>
                    <td>{{ entity.sitioAplicacion ? entity.sitioAplicacion : '--' }}</td>
                    <td class="small">{{ entity.fabricante ? entity.fabricante : '--' }}</td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            {% for reaccion in entity.reacciones %}
                                <span class="apple-role-pill text-bg-warning">{{ reaccion.nombre }}</span>
                            {% else %}
                                <span class="text-muted small">Ninguna</span>
                            {% endfor %}
                        </div>
                    </td>
                    <td class="text-nowrap small text-secondary">{{ entity.fechaAplicacion|date('d/m/Y', false) }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
