<div class="apple-section">
    <div class="apple-section-header">
        <h5 class="text-body"><i class="bi bi-person-wheelchair text-success me-2"></i> Discapacidades Declaradas</h5>
        <small class="text-secondary">Condiciones funcionales y ayudas técnicas</small>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle dtHere">
            <thead>
                <tr class="text-secondary small text-uppercase">
                    <th>Discapacidad</th>
                    <th>Grado</th>
                    <th>Nro. Certificado</th>
                    <th>Congénita</th>
                    <th>Ayuda Técnica</th>
                    <th>Limitaciones</th>
                    <th>Observaciones</th>
                </tr>
            </thead>
            <tbody>
            {% for entity in discapacidades %}
                <tr>
                    <td class="fw-semibold">{{ entity.discapacidad }}</td>
                    <td>
                        {% if entity.porcentaje <= 30 %}
                            <span class="badge rounded-pill text-bg-success px-2 py-1">{{ entity.porcentaje }}%</span>
                        {% elseif entity.porcentaje <= 60 %}
                            <span class="badge rounded-pill text-bg-warning px-2 py-1">{{ entity.porcentaje }}%</span>
                        {% else %}
                            <span class="badge rounded-pill text-bg-danger px-2 py-1">{{ entity.porcentaje }}%</span>
                        {% endif %}
                    </td>
                    <td>{{ entity.numeroCertificado ? entity.numeroCertificado : '--' }}</td>
                    <td>
                        {% if entity.congenita %}
                            <span class="badge rounded-pill text-bg-secondary px-2">Sí</span>
                        {% else %}
                            <span class="badge rounded-pill text-bg-light border px-2">No</span>
                        {% endif %}
                    </td>
                    <td>{{ entity.ayudaTecnica ? entity.ayudaTecnica : '--' }}</td>
                    <td class="small">{{ entity.limitacionesFuncionales ? entity.limitacionesFuncionales : '--' }}</td>
                    <td class="small text-secondary">{{ entity.observaciones ? entity.observaciones : '--' }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
