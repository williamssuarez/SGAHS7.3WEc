{% extends 'base.html.twig' %}

{% block title %}Historial de Hospitalizaciones{% endblock %}

{% block titlewrap %}
    Hospitalizaciones
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">Historial</li>
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}
    <div class="container-fluid px-4">
        <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
            <h2 class="text-dark fw-bold m-0"><i class="bi bi-clock-history"></i> Historial General de Hospitalizaciones</h2>
            
        </div>

        <form method="get" action="{{ path('app_hospitalizacion_index') }}" class="row g-3 mb-4">
            <div class="row">
                <div class="col-md-3">
                    <label class="fw-bold">Desde</label>
                    <input type="date" name="startDate" value="{{ startDate }}" class="form-control shadow-sm">
                </div>
                <div class="col-md-3">
                    <label class="fw-bold">Hasta</label>
                    <input type="date" name="endDate" value="{{ endDate }}" class="form-control shadow-sm">
                </div>
                <div class="col-md-3">
                    <label class="fw-bold">Estado</label>
                    <select name="state" class="form-select shadow-sm noSrchSelect">
                        <option value="all" {{ currentState == 'all' ? 'selected' }}>Todos los Estados</option>
                        <option value="pending_bed" {{ currentState == 'pending_bed' ? 'selected' }}>En Espera de Cama</option>
                        <option value="admitted" {{ currentState == 'admitted' ? 'selected' }}>Admitidos</option>
                        <option value="discharged" {{ currentState == 'discharged' ? 'selected' }}>Dados de Alta</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary shadow-sm w-100 fw-bold">
                        <i class="bi bi-funnel-fill"></i> Filtrar Historial
                    </button>
                </div>
            </div>
        </form>

        <div class="card shadow-sm border-top border-primary border-4"><div class="card-header d-flex justify-content-between align-items-center"><h3 class="card-title m-0">Resultados</h3><span class="text-muted small ms-auto"><i class="bi bi-info-circle"></i> Puedes buscar por <strong>Paciente o Medico Tratante</strong></span></div>
            <div class="card-body p-0">
                
                    <div class="table-responsive">
                        <div class="dtHereServer table-responsive" data-dt-config="{{ datatable_settings(datatable)|escape('html_attr') }}">Cargando registros...</div>
                    </div>
                
            </div>
        </div>
    </div>
{% endblock %}







