{% extends 'base.html.twig' %}

{% block title %}Historial de Hospitalizaciones{% endblock %}

{% block titlewrap %}
    Hospitalizaciones
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">Historial</li>
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}
    <div class="container-fluid px-4">
        <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
            <h2 class="text-dark fw-bold">
                <i class="bi bi-clock-history"></i> Historial General de Hospitalizaciones
            </h2>
            <span class="badge bg-secondary fs-6 rounded-pill">
            {{ entities|length }} Registros
        </span>
        </div>

        <form method="get" action="{{ path('app_hospitalizacion_index') }}" class="row g-3 mb-4">
            <div class="row">
                <div class="col-md-3">
                    <label class="fw-bold">Desde</label>
                    <input type="date" name="startDate" value="{{ startDate }}" class="form-control shadow-sm">
                </div>
                <div class="col-md-3">
                    <label class="fw-bold">Hasta</label>
                    <input type="date" name="endDate" value="{{ endDate }}" class="form-control shadow-sm">
                </div>
                <div class="col-md-3">
                    <label class="fw-bold">Estado</label>
                    <select name="state" class="form-select shadow-sm noSrchSelect">
                        <option value="all" {{ currentState == 'all' ? 'selected' }}>Todos los Estados</option>
                        <option value="pending_bed" {{ currentState == 'pending_bed' ? 'selected' }}>En Espera de Cama</option>
                        <option value="admitted" {{ currentState == 'admitted' ? 'selected' }}>Admitidos</option>
                        <option value="discharged" {{ currentState == 'discharged' ? 'selected' }}>Dados de Alta</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary shadow-sm w-100 fw-bold">
                        <i class="bi bi-funnel-fill"></i> Filtrar Historial
                    </button>
                </div>
            </div>
        </form>

        <div class="card shadow-sm border-top border-primary border-4">
            <div class="card-body p-0">
                {% if entities is empty %}
                    <div class="text-center p-5">
                        <i class="bi bi-folder-x text-muted display-1 mb-3"></i>
                        <h4 class="text-muted">No hay hospitalizaciones registradas</h4>
                        <p class="text-muted">El historial histórico está vacío.</p>
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 dtHere">
                            <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Fecha Ingreso</th>
                                <th>Paciente</th>
                                <th>Médico Tratante</th>
                                <th>Estado</th>
                                <th class="text-end">Acción</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for hospitalizacion in entities %}
                                <tr>
                                    <td>
                                        <strong>#{{ hospitalizacion.id }}</strong>
                                    </td>
                                    <td>
                                        {{ hospitalizacion.fechaIngreso|date('d/m/Y H:i A') }}<br>
                                        {% if hospitalizacion.fechaEgreso %}
                                            <small class="text-muted">Alta: {{ hospitalizacion.fechaEgreso|date('d/m/Y H:i A') }}</small>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <strong>{{ hospitalizacion.paciente.nombre }} {{ hospitalizacion.paciente.apellido }}</strong><br>
                                        <small class="text-muted">{{ hospitalizacion.paciente.tipoDocumento }} - {{ hospitalizacion.paciente.cedula|number_format(0, ',', '.') }}</small>
                                    </td>
                                    <td>
                                        {% if hospitalizacion.medicoTratante %}
                                            Dr(a). {{ hospitalizacion.medicoTratante.internalProfile.nombre }}
                                        {% else %}
                                            <span class="text-muted fst-italic">Sin asignar</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if hospitalizacion.estado.value == 'discharged' %}
                                            <span class="badge bg-secondary"><i class="bi bi-check-all"></i> Alta Médica</span>
                                        {% elseif hospitalizacion.estado.value == 'pending_bed' %}
                                            <span class="badge bg-warning text-dark"><i class="bi bi-clock"></i> Pendiente</span>
                                        {% else %}
                                            <span class="badge bg-success"><i class="bi bi-heart-pulse"></i> Ingresado</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        <a href="{{ path('app_hospitalizacion_expediente', {'id': hospitalizacion.id}) }}" class="btn btn-outline-primary btn-sm shadow-sm">
                                            <i class="bi bi-folder2-open"></i> Ver Expediente
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}


