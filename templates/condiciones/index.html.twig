{% extends 'catalog/_base_index.html.twig' %}
{% import 'catalog/_actions.html.twig' as actions %}

{% set catalog_title = 'Condiciones' %}
{% set catalog_header_title = 'Condiciones Registradas' %}
{% set catalog_subtitle = 'Listado y administración de condiciones médicas preexistentes y crónicas' %}
{% set catalog_icon = 'bi-clipboard2-pulse' %}
{% set new_route = 'app_condiciones_new' %}

{% block table_head %}
    <th>Nombre</th>
    <th>Descripción</th>
{% endblock %}

{% block table_body %}
    {% for entity in entities %}
        <tr>
            <td class="fw-semibold">{{ entity.nombre }}</td>
            <td class="text-muted">{{ entity.descripcion|default('Sin descripción') }}</td>
            <td>
                {{ actions.row_actions(
                    path('app_condiciones_show', {'id': entity.id}),
                    path('app_condiciones_edit', {'id': entity.id}),
                    path('app_condiciones_delete', {'id': entity.id}),
                    entity.id
                ) }}
            </td>
        </tr>
    {% endfor %}
{% endblock %}
