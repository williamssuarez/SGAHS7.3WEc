{% extends 'base.html.twig' %}

{% block title %}Dashboard Principal | SGAHS{% endblock %}

{% block titlewrap %}
    Resumen Global del Sistema
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_index') }}">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
{% endblock %}

{% block body %}
    <div class="container-fluid px-0 px-md-2" 
         data-controller="dashboard-charts"
         data-dashboard-charts-endpoint-value="{{ path('api_dashboard_admin') }}">

        <!-- 4 Tarjetas KPI Apple -->
        <div class="row g-3 mb-4">
            <!-- Card 1: Pacientes Registrados -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="apple-kpi-card" data-controller="apple-spring">
                    <div class="apple-kpi-header">
                        <div class="apple-kpi-icon apple-kpi-icon-blue">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <span class="apple-kpi-badge">Censo Total</span>
                    </div>
                    <div class="apple-kpi-body">
                        <div class="apple-kpi-value" data-dashboard-charts-target="card1">
                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                        <p class="apple-kpi-label">Pacientes Registrados</p>
                    </div>
                    <div class="apple-kpi-footer">
                        <a href="{{ path('app_paciente_index') }}" class="apple-kpi-link">
                            <span>Ver pacientes</span>
                            <i class="bi bi-arrow-right-short"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Card 2: Citas Hoy -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="apple-kpi-card" data-controller="apple-spring">
                    <div class="apple-kpi-header">
                        <div class="apple-kpi-icon apple-kpi-icon-green">
                            <i class="bi bi-calendar-check-fill"></i>
                        </div>
                        <span class="apple-kpi-badge">Hoy</span>
                    </div>
                    <div class="apple-kpi-body">
                        <div class="apple-kpi-value" data-dashboard-charts-target="card2">
                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                        <p class="apple-kpi-label">Citas Agendadas</p>
                    </div>
                    <div class="apple-kpi-footer">
                        <a href="{{ path('app_citas_index_expected') }}" class="apple-kpi-link">
                            <span>Ver agenda</span>
                            <i class="bi bi-arrow-right-short"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Card 3: Cirugías Hoy -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="apple-kpi-card" data-controller="apple-spring">
                    <div class="apple-kpi-header">
                        <div class="apple-kpi-icon apple-kpi-icon-amber">
                            <i class="bi bi-heart-pulse-fill"></i>
                        </div>
                        <span class="apple-kpi-badge">Programadas</span>
                    </div>
                    <div class="apple-kpi-body">
                        <div class="apple-kpi-value" data-dashboard-charts-target="card3">
                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                        <p class="apple-kpi-label">Cirugías Hoy</p>
                    </div>
                    <div class="apple-kpi-footer">
                        <a href="{{ path('app_cirugia_agenda') }}" class="apple-kpi-link">
                            <span>Ver quirófanos</span>
                            <i class="bi bi-arrow-right-short"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Card 4: Emergencias Activas -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="apple-kpi-card" data-controller="apple-spring">
                    <div class="apple-kpi-header">
                        <div class="apple-kpi-icon apple-kpi-icon-red">
                            <i class="bi bi-lightning-charge-fill"></i>
                        </div>
                        <span class="apple-kpi-badge">En Atención</span>
                    </div>
                    <div class="apple-kpi-body">
                        <div class="apple-kpi-value" data-dashboard-charts-target="card4">
                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                        <p class="apple-kpi-label">Emergencias Activas</p>
                    </div>
                    <div class="apple-kpi-footer">
                        <a href="{{ path('app_emergencia_index') }}" class="apple-kpi-link">
                            <span>Ver triaje</span>
                            <i class="bi bi-arrow-right-short"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Fila de Gráficos Apple Glass -->
        <div class="row g-3">
            <!-- Gráfico de Tendencia (7 días) -->
            <div class="col-12 col-lg-7">
                <div class="apple-chart-card shadow-sm">
                    <div class="apple-chart-header">
                        <div class="apple-chart-title-group">
                            <div class="apple-chart-icon-badge badge-blue">
                                <i class="bi bi-graph-up-arrow"></i>
                            </div>
                            <div>
                                <h3 class="apple-chart-title">Volumen de Atención</h3>
                                <p class="apple-chart-subtitle">Citas, consultas y emergencias</p>
                            </div>
                        </div>
                        <span class="apple-chart-badge">Últimos 7 días</span>
                    </div>
                    <div class="apple-chart-canvas-wrap">
                        <!-- Spinner de carga -->
                        <div data-dashboard-charts-target="barLoading" class="d-flex align-items-center justify-content-center h-100">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando gráfico...</span>
                            </div>
                        </div>
                        <!-- Canvas Chart.js -->
                        <canvas data-dashboard-charts-target="barChart" class="d-none"></canvas>
                    </div>
                </div>
            </div>

            <!-- Gráfico Doughnut: Citas Hoy -->
            <div class="col-12 col-lg-5">
                <div class="apple-chart-card shadow-sm">
                    <div class="apple-chart-header">
                        <div class="apple-chart-title-group">
                            <div class="apple-chart-icon-badge badge-amber">
                                <i class="bi bi-pie-chart-fill"></i>
                            </div>
                            <div>
                                <h3 class="apple-chart-title">Distribución de Citas</h3>
                                <p class="apple-chart-subtitle">Estado de la agenda diaria</p>
                            </div>
                        </div>
                        <span class="apple-chart-badge">Hoy</span>
                    </div>
                    <div class="apple-chart-canvas-wrap">
                        <!-- Spinner de carga -->
                        <div data-dashboard-charts-target="pieLoading" class="d-flex align-items-center justify-content-center h-100">
                            <div class="spinner-border text-info" role="status">
                                <span class="visually-hidden">Cargando distribución...</span>
                            </div>
                        </div>
                        <!-- Contenedor vacío si no hay citas -->
                        <div data-dashboard-charts-target="pieEmpty" class="d-none align-items-center justify-content-center flex-column h-100">
                            <i class="bi bi-calendar-x text-muted mb-2" style="font-size: 2.5rem; opacity: 0.6;"></i>
                            <p class="text-muted mb-0 small">No hay citas agendadas para hoy.</p>
                        </div>
                        <!-- Canvas Chart.js -->
                        <canvas data-dashboard-charts-target="pieChart" class="d-none"></canvas>
                    </div>
                </div>
            </div>
        </div>

    </div>
{% endblock %}
