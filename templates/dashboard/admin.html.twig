{% extends 'base.html.twig' %}

{% block title %}Dashboard Principal{% endblock %}

{% block titlewrap %}
    Resumen Global del Sistema
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="#">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
{% endblock %}

{% block body %}
    <div class="container-fluid" 
         data-controller="dashboard-charts"
         data-dashboard-charts-endpoint-value="{{ path('api_dashboard_admin') }}">

        <!-- 4 Cards Superiores (Estilo AdminLTE 4) -->
        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box text-bg-primary">
                    <div class="inner">
                        <h3 data-dashboard-charts-target="card1">
                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </h3>
                        <p>Pacientes Registrados</p>
                    </div>
                    <i class="small-box-icon bi bi-people-fill"></i>
                    <a href="{{ path('app_paciente_index') }}" class="small-box-footer link-light link-underline-opacity-0 link-underline-opacity-50-hover">
                        Más información <i class="bi bi-arrow-right-circle-fill"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box text-bg-success">
                    <div class="inner">
                        <h3 data-dashboard-charts-target="card2">
                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </h3>
                        <p>Citas Agendadas Hoy</p>
                    </div>
                    <i class="small-box-icon bi bi-calendar-check-fill"></i>
                    <a href="{{ path('app_citas_index_expected') }}" class="small-box-footer link-light link-underline-opacity-0 link-underline-opacity-50-hover">
                        Más información <i class="bi bi-arrow-right-circle-fill"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box text-bg-warning">
                    <div class="inner">
                        <h3 class="text-dark" data-dashboard-charts-target="card3">
                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </h3>
                        <p class="text-dark">Cirugías Hoy</p>
                    </div>
                    <i class="small-box-icon bi bi-activity text-dark"></i>
                    <a href="{{ path('app_cirugia_agenda') }}" class="small-box-footer link-dark link-underline-opacity-0 link-underline-opacity-50-hover">
                        Más información <i class="bi bi-arrow-right-circle-fill"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box text-bg-danger">
                    <div class="inner">
                        <h3 data-dashboard-charts-target="card4">
                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </h3>
                        <p>Emergencias Activas</p>
                    </div>
                    <i class="small-box-icon bi bi-heart-pulse-fill"></i>
                    <a href="{{ path('app_emergencia_index') }}" class="small-box-footer link-light link-underline-opacity-0 link-underline-opacity-50-hover">
                        Más información <i class="bi bi-arrow-right-circle-fill"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Fila de Gráficos -->
        <div class="row mt-2">
            <!-- Gráfico de Área/Líneas -->
            <div class="col-lg-7">
                <div class="card mb-4 shadow-sm border-0">
                    <div class="card-header border-0 bg-transparent">
                        <h3 class="card-title fw-bold text-secondary">
                            <i class="bi bi-graph-up-arrow text-primary me-2"></i>
                            Volumen de Atención (7 días)
                        </h3>
                    </div>
                    <div class="card-body">
                        <div style="position: relative; height: 320px; width: 100%;">
                            <!-- Spinner de carga para barras -->
                            <div data-dashboard-charts-target="barLoading" class="d-flex align-items-center justify-content-center h-100">
                                <div class="spinner-border text-primary" role="status"></div>
                            </div>
                            <!-- Canvas oculto inicialmente -->
                            <canvas data-dashboard-charts-target="barChart" class="d-none"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Gráfico de Torta / Doughnut -->
            <div class="col-lg-5">
                <div class="card mb-4 shadow-sm border-0">
                    <div class="card-header border-0 bg-transparent">
                        <h3 class="card-title fw-bold text-secondary">
                            <i class="bi bi-pie-chart-fill text-danger me-2"></i>
                            Distribución de Citas Hoy
                        </h3>
                    </div>
                    <div class="card-body">
                        <div style="position: relative; height: 320px; width: 100%;">
                            <!-- Spinner de carga -->
                            <div data-dashboard-charts-target="pieLoading" class="d-flex align-items-center justify-content-center h-100">
                                <div class="spinner-border text-info" role="status"></div>
                            </div>
                            <!-- Contenedor vacío si no hay citas -->
                            <div data-dashboard-charts-target="pieEmpty" class="d-none align-items-center justify-content-center h-100">
                                <div class="text-center text-muted">
                                    <i class="bi bi-calendar-x fs-1 mb-2"></i>
                                    <p class="mb-0">No hay citas agendadas para hoy.</p>
                                </div>
                            </div>
                            <!-- Canvas oculto inicialmente -->
                            <canvas data-dashboard-charts-target="pieChart" class="d-none"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
