{% extends 'base.html.twig' %}

{% block title %}Gestión de Base de Datos{% endblock %}

{% block titlewrap %}
    Respaldos de Base de Datos
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">Base de Datos</li>
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert apple-alert apple-alert-{{ label == 'error' or label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} alert-dismissible fade show mb-4" role="alert">
                <i class="bi {{ label == 'error' or label == 'danger' ? 'bi-exclamation-octagon-fill' : (label == 'warning' ? 'bi-exclamation-triangle-fill' : 'bi-check-circle-fill') }} me-2"></i>
                <div class="flex-grow-1">{{ message }}</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="apple-table-card shadow-sm mb-4">
        <div class="apple-table-header d-flex flex-wrap justify-content-between align-items-center gap-3 pb-3 mb-3 border-bottom">
            <div class="d-flex align-items-center gap-3">
                <div class="apple-header-icon-badge">
                    <i class="bi bi-database-fill-gear"></i>
                </div>
                <div>
                    <h3 class="apple-table-title m-0">Respaldos de Base de Datos</h3>
                    <p class="apple-table-subtitle text-muted small m-0">
                        <i class="bi bi-info-circle me-1"></i> Copias de seguridad completas del sistema para contingencia y recuperación
                    </p>
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2 ms-auto">
                <a href="{{ path('app_database_schedule') }}" class="btn btn-secondary apple-btn-secondary rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2" data-controller="apple-spring" title="Configurar programación automática">
                    <i class="bi bi-clock-history"></i>
                    <span>Programación</span>
                </a>

                <form action="{{ path('app_database_backup') }}" method="post" class="d-inline"
                      data-controller="confirm-submit apple-spring"
                      data-action="submit->confirm-submit#confirm"
                      data-confirm-submit-title-value="Confirmar Respaldo"
                      data-confirm-submit-text-value="¿Está seguro de que desea crear un respaldo ahora? Este proceso puede tardar unos minutos."
                      data-confirm-submit-icon-value="info"
                      data-confirm-submit-confirm-button-text-value="Sí, crear respaldo"
                      data-confirm-submit-loading-text-value="Creando respaldo..."
                >
                    <input type="hidden" name="_token" value="{{ csrf_token('backup') }}">
                    <button type="submit" class="btn btn-primary apple-btn-primary rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2" title="Generar nuevo respaldo manual">
                        <i class="bi bi-cloud-arrow-down-fill"></i>
                        <span>Crear Respaldo</span>
                    </button>
                </form>
            </div>
        </div>

        <div class="apple-table-body">
            <table class="table table-hover dtHere align-middle mb-0" style="width: 100%;">
                <thead>
                    <tr>
                        <th>Nombre del Archivo</th>
                        <th>Fecha de Creación</th>
                        <th>Tamaño</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for backup in backups %}
                        <tr class="align-middle">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-file-earmark-zip-fill text-primary fs-5 opacity-75"></i>
                                    <code class="apple-code-badge">{{ backup.name }}</code>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1 text-nowrap">
                                    <i class="bi bi-clock text-secondary opacity-75 small me-1"></i>
                                    <span>{{ backup.date|date('d/m/Y h:i:s A', 'America/Caracas') }}</span>
                                </div>
                            </td>
                            <td>
                                <span class="apple-role-pill text-bg-secondary">{{ (backup.size / 1024 / 1024)|number_format(2) }} MB</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center justify-content-end gap-2 flex-wrap">
                                    <a href="{{ path('app_database_import', {'filename': backup.name}) }}" class="btn btn-sm btn-outline-warning apple-btn-warning rounded-pill px-3 py-1 d-inline-flex align-items-center gap-1" data-controller="apple-spring" title="Restaurar base de datos desde este archivo">
                                        <i class="bi bi-cloud-arrow-up-fill"></i>
                                        <span>Restaurar</span>
                                    </a>

                                    <form action="{{ path('app_database_delete', {'filename': backup.name}) }}" method="post" class="d-inline"
                                          data-controller="confirm-submit apple-spring"
                                          data-action="submit->confirm-submit#confirm"
                                          data-confirm-submit-title-value="Eliminar Respaldo"
                                          data-confirm-submit-text-value="¿Está seguro de que desea eliminar permanentemente este archivo de respaldo?"
                                          data-confirm-submit-icon-value="warning"
                                          data-confirm-submit-confirm-button-text-value="Sí, eliminar"
                                          data-confirm-submit-loading-text-value="Eliminando..."
                                    >
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_backup') }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger apple-btn-danger rounded-pill px-3 py-1 d-inline-flex align-items-center gap-1" title="Eliminar archivo permanentemente">
                                            <i class="bi bi-trash3-fill"></i>
                                            <span>Eliminar</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
