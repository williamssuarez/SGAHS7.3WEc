{% extends 'base.html.twig' %}

{% block title %}Gestión de Base de Datos{% endblock %}

{% block titlewrap %}
    Respaldos de Base de Datos
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">Base de Datos</li>
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card card-primary card-outline">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="card-title">Respaldos Disponibles</h3>

            <div class="ms-auto">
                <a href="{{ path('app_database_schedule') }}" class="btn btn-secondary btn-sm me-2">
                    <i class="bi bi-clock-fill"></i> Programación Automática
                </a>
                
                <form action="{{ path('app_database_backup') }}" method="post" style="display:inline;"
                      data-controller="confirm-submit"
                  data-action="submit->confirm-submit#confirm"
                  data-confirm-submit-title-value="Confirmar Respaldo"
                  data-confirm-submit-text-value="¿Está seguro de que desea crear un respaldo ahora? Este proceso puede tardar unos minutos."
                  data-confirm-submit-icon-value="info"
                  data-confirm-submit-confirm-button-text-value="Sí, crear respaldo"
                  data-confirm-submit-loading-text-value="Creando respaldo..."
            >
                <input type="hidden" name="_token" value="{{ csrf_token('backup') }}">
                <button type="submit" class="btn btn-primary btn-sm ms-auto">
                    <i class="bi bi-cloud-arrow-down-fill"></i> Crear Respaldo Ahora
                </button>
            </form>
            </div>
        </div>

        <div class="card-body">
            <table class="table dtHere">
                <thead>
                    <tr>
                        <th>Nombre del Archivo</th>
                        <th>Fecha de Creación</th>
                        <th>Tamaño</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for backup in backups %}
                        <tr class="align-middle">
                            <td>{{ backup.name }}</td>
                            <td>{{ backup.date|date('d/m/Y h:i:s A', 'America/Caracas') }}</td>
                            <td>{{ (backup.size / 1024 / 1024)|number_format(2) }} MB</td>
                            <td>
                                <a href="{{ path('app_database_import', {'filename': backup.name}) }}" class="btn btn-warning btn-sm">
                                    <i class="bi bi-cloud-arrow-up-fill"></i> Restaurar
                                </a>
                                <form action="{{ path('app_database_delete', {'filename': backup.name}) }}" method="post" style="display:inline;"
                                      data-controller="confirm-submit"
                                      data-action="submit->confirm-submit#confirm"
                                      data-confirm-submit-title-value="Eliminar Respaldo"
                                      data-confirm-submit-text-value="¿Está seguro de que desea eliminar permanentemente este archivo de respaldo?"
                                      data-confirm-submit-icon-value="error"
                                      data-confirm-submit-confirm-button-text-value="Sí, eliminar"
                                      data-confirm-submit-loading-text-value="Eliminando..."
                                >
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_backup') }}">
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash-fill"></i> Eliminar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
