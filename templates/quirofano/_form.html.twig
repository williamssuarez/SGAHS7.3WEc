{{ form_start(form, {
    'attr': {
        'data-controller': 'submit-once medication-status',
        'data-action': 'submit->submit-once#disable'
    }
}) }}
<div class="card-body">
    <div class="row">
        <div class="col-md-6 mb-3">
            {{form_label( form.nombre ) }}
            {{form_widget( form.nombre ) }}
            {{form_errors( form.nombre ) }}
        </div>
        
        {% if form.estado is defined %}
        <div class="col-md-6 mb-3">
            {{form_label( form.estado ) }}
            {{form_widget( form.estado ) }}
            {{form_errors( form.estado ) }}
        </div>
        {% endif %}
    </div>
</div>

<div class="card-footer">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between">
                <a class="btn btn-primary" href="{{ path('app_quirofano_index') }}">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>

                <div class="d-flex">
                    <button type="submit" class="btn btn-success" data-submit-once-target="submitButton">
                        {{ button_label|default('Guardar') }}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{{ form_end(form) }}
