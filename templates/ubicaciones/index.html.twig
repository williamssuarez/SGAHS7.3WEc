{% extends 'base.html.twig' %}

{% block title %}Gestión de Ubicaciones{% endblock %}

{% block titlewrap %}
    Ubicaciones (Zonificación)
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">Gestión de Ubicaciones</li>
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row">
        <div class="col-md-12">
            <div class="card card-primary card-outline mb-4">
                <div class="card-header">
                    <h3 class="card-title">Árbol de Ubicaciones</h3>
                </div>
                
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush" id="tree-root">
                        {% for estado in estados %}
                            <li class="list-group-item">
                                <details>
                                    <summary class="d-flex align-items-center justify-content-between" style="cursor: pointer; list-style: none;">
                                        <div>
                                            <i class="bi bi-chevron-right me-2 chevron-icon transition-transform"></i>
                                            <strong class="text-primary">{{ estado.nombre }}</strong>
                                        </div>
                                        <a href="{{ path('app_estado_edit', {id: estado.id}) }}" data-turbo-frame="_top" class="btn btn-sm text-secondary p-0 m-0" title="Editar"><i class="bi bi-pencil-square"></i></a>
                                    </summary>
                                    <div class="ps-4 pt-2">
                                        <turbo-frame id="estado_{{ estado.id }}_municipios" src="{{ path('app_ubicaciones_municipios', {id: estado.id}) }}" loading="lazy">
                                            <div class="text-muted small my-2"><i class="spinner-border spinner-border-sm me-2"></i> Cargando municipios...</div>
                                        </turbo-frame>
                                    </div>
                                </details>
                            </li>
                        {% endfor %}
                        <li class="list-group-item mt-2">
                            <form action="{{ path('app_ubicaciones_index') }}" method="POST" class="d-flex w-50">
                                <input type="text" name="nombre" class="form-control me-2" placeholder="Nuevo Estado" required>
                                <button type="submit" class="btn btn-primary" title="Añadir"><i class="bi bi-plus-lg"></i></button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <style>
        /* Arrow animation logic */
        details summary::-webkit-details-marker {
            display: none;
        }
        details[open] > summary .chevron-icon {
            transform: rotate(90deg);
        }
        .transition-transform {
            transition: transform 0.2s ease-in-out;
        }
        details > summary {
            outline: none;
            user-select: none;
        }
    </style>
{% endblock %}
