<turbo-frame id="estado_{{ estado.id }}_municipios">
    <ul class="apple-tree-list mb-2">
        {% for municipio in estado.municipios %}
            <li class="apple-tree-item">
                <details>
                    <summary class="apple-tree-node" data-controller="apple-inline-edit" data-apple-inline-edit-url-value="{{ path('app_ubicaciones_rename', {type: 'municipio', id: municipio.id}) }}">
                        {# Modo Vista #}
                        <div class="apple-tree-node-display" data-apple-inline-edit-target="display">
                            <div class="apple-tree-node-content">
                                <i class="bi bi-chevron-right apple-tree-chevron"></i>
                                <span class="apple-tree-badge badge-municipio" title="Nivel: Municipio">
                                    <i class="bi bi-buildings-fill"></i>
                                </span>
                                <span class="apple-tree-node-text" data-apple-inline-edit-target="label" title="{{ municipio.nombre }}">{{ municipio.nombre }}</span>
                                <span class="apple-tree-pill ms-1 d-none d-sm-inline-flex flex-shrink-0">{{ municipio.parroquias|length }} parr</span>
                            </div>
                            <div class="apple-tree-node-actions">
                                <button type="button" class="apple-tree-action-btn apple-spring" data-action="click->apple-inline-edit#start" title="Editar Municipio {{ municipio.nombre }}">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                            </div>
                        </div>

                        {# Modo Edición Inline #}
                        <div class="apple-tree-inline-edit d-none" data-apple-inline-edit-target="form">
                            <span class="apple-tree-badge badge-municipio" title="Editando Municipio">
                                <i class="bi bi-buildings-fill"></i>
                            </span>
                            <input type="text"
                                   class="form-control form-control-sm apple-tree-input"
                                   data-apple-inline-edit-target="input"
                                   data-action="keydown->apple-inline-edit#handleKeydown"
                                   placeholder="Nombre del municipio..."
                                   autocomplete="off">
                            <button type="button"
                                    class="btn btn-sm btn-primary apple-btn-primary btn-inline-save apple-spring"
                                    data-apple-inline-edit-target="saveBtn"
                                    data-action="click->apple-inline-edit#save"
                                    title="Guardar nombre">
                                <i class="bi bi-check-lg"></i>
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-secondary apple-btn-secondary btn-inline-cancel apple-spring"
                                    data-action="click->apple-inline-edit#cancel"
                                    title="Cancelar">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </summary>
                    <div class="apple-tree-branch">
                        <turbo-frame id="municipio_{{ municipio.id }}_parroquias" src="{{ path('app_ubicaciones_parroquias', {id: municipio.id}) }}" loading="lazy">
                            <div class="apple-tree-loading d-flex align-items-center gap-2">
                                <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                                <span>Cargando parroquias...</span>
                            </div>
                        </turbo-frame>
                    </div>
                </details>
            </li>
        {% else %}
            <li class="apple-tree-item">
                <div class="apple-tree-empty">
                    <i class="bi bi-info-circle me-1"></i> Sin municipios registrados.
                </div>
            </li>
        {% endfor %}
        <li class="apple-tree-item mt-2">
            <form action="{{ path('app_ubicaciones_municipios', {id: estado.id}) }}" method="POST" class="apple-tree-add-bar d-flex align-items-center gap-2" data-turbo-frame="estado_{{ estado.id }}_municipios" data-controller="submit-once" data-action="submit->submit-once#disable">
                <span class="apple-tree-badge badge-municipio d-none d-sm-inline-flex" title="Nuevo Municipio">
                    <i class="bi bi-plus-lg"></i>
                </span>
                <input type="text" name="nombre" class="form-control form-control-sm apple-tree-input flex-grow-1" placeholder="Nuevo municipio..." required autocomplete="off">
                <button type="submit" class="btn btn-sm btn-outline-primary apple-btn-secondary rounded-pill px-3 py-1 d-inline-flex align-items-center gap-1 text-nowrap" data-submit-once-target="submitButton" data-controller="apple-spring">
                    <i class="bi bi-plus-lg"></i>
                    <span class="d-none d-sm-inline">Añadir</span>
                </button>
            </form>
        </li>
    </ul>
</turbo-frame>
