{% extends 'base.html.twig' %}

{% block title %}Historial de Visitas{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="container-fluid px-4">
        <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
            <h2 class="text-dark fw-bold m-0"><i class="bi bi-clock-history"></i> Historial de Visitas</h2>
            <a href="{{ path('app_visita_hospitalaria_index') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver a Visitas Activas
            </a>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body bg-light rounded">
                <form method="get" action="{{ path('app_visita_hospitalaria_historial') }}" class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted">Desde</label>
                        <input type="date" name="start_date" class="form-control" value="{{ startDate }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted">Hasta</label>
                        <input type="date" name="end_date" class="form-control" value="{{ endDate }}">
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-funnel-fill"></i> Filtrar
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card shadow-sm border-top border-info border-4 mb-4"><div class="card-header d-flex justify-content-between align-items-center"><h3 class="card-title m-0">Resultados</h3><span class="text-muted small ms-auto"><i class="bi bi-info-circle"></i> Puedes buscar por <strong>Nombre o CI del Visitante, o Nombre del Paciente</strong></span></div>
            <div class="card-body p-0">
                <div class="dtHereServer table-responsive" data-dt-config="{{ datatable_settings(datatable)|escape('html_attr') }}">Cargando registros...</div>
            </div>
        </div>
    </div>
{% endblock %}




