{% extends 'base.html.twig' %}

{% block title %}Editar Visita{% endblock %}

{% block body %}
    <div class="container-fluid px-4 mt-3">
        <h2 class="mb-4 fw-bold text-dark"><i class="bi bi-pencil-square"></i> Editar Visita</h2>

        <div class="row">
            <div class="col-md-7">
                <div class="card shadow-sm border-0 mb-4">
                    {{ include('visita_hospitalaria/_form.html.twig', {'button_label': 'Guardar Cambios'}) }}
                </div>
            </div>
            <div class="col-md-5">
                <div class="card shadow-sm border-danger border-top border-4">
                    <div class="card-body">
                        <h5 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Zona de Peligro</h5>
                        <p class="text-muted">Al eliminar la visita se anulará su registro por completo.</p>
                        {{ include('visita_hospitalaria/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

