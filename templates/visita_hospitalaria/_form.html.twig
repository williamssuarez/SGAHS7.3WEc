{{ form_start(form, {
    'attr': {
        'data-controller': 'submit-once',
        'data-action': 'submit->submit-once#disable'
    }
}) }}
{{ include('base/_form_error_messages.html.twig') }}
<div class="card-body">
    <h5 class="mb-4">Datos del Visitante</h5>
    <div class="row mb-3">
        <div class="col-md-12">
            {{ form_label( form.identificacionVisitante ) }}
            {{ form_widget( form.identificacionVisitante ) }}
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-12">
            {{ form_label( form.nombreVisitante ) }}
            {{ form_widget( form.nombreVisitante ) }}
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-12">
            {{ form_label( form.parentesco ) }}
            {{ form_widget( form.parentesco ) }}
        </div>
    </div>
</div>

<div class="card-footer bg-light">
    <div class="d-flex justify-content-between">
        <a class="btn btn-outline-secondary" href="{{ path('app_visita_hospitalaria_index') }}">
            <i class="bi bi-arrow-left"></i> Cancelar y Volver
        </a>
        <button type="submit" class="btn btn-primary" data-submit-once-target="submitButton">
            <i class="bi bi-check-circle"></i> {{ button_label|default('Registrar Visita') }}
        </button>
    </div>
</div>
{{ form_end(form) }}

