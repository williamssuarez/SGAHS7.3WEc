<form method="post" action="{{ path('app_visita_hospitalaria_delete', {'id': visita_hospitalarium.id}) }}" data-controller="confirm-finalizar" data-action="submit->confirm-finalizar#confirm" data-confirm-finalizar-title-value="¿Eliminar Visita?" data-confirm-finalizar-text-value="Esta acción no se puede deshacer y borrará la visita del historial." data-confirm-finalizar-confirm-button-text-value="Sí, eliminar">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ visita_hospitalarium.id) }}">
    <button class="btn btn-outline-danger w-100"><i class="bi bi-trash"></i> Eliminar Registro</button>
</form>

