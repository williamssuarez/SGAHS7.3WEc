{# templates/visitas/dashboard.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Control de Visitantes{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="container-fluid px-4">
        <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
            <h2 class="text-dark fw-bold"><i class="bi bi-people-fill"></i> Visitantes Activos</h2>
            <div>
                <a href="{{ path('app_visita_hospitalaria_historial') }}" class="btn btn-outline-secondary me-2">
                    <i class="bi bi-clock-history"></i> Historial
                </a>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newVisitorModal">
                    <i class="bi bi-person-plus-fill"></i> Registrar Nuevo Visitante
                </button>
            </div>
        </div>

        <div class="card shadow-sm border-top border-info border-4 mb-4">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0 dtHere">
                    <thead class="table-light">
                    <tr>
                        <th>Hora Entrada</th>
                        <th>Visitante</th>
                        <th>Parentesco</th>
                        <th>Visitando a (Paciente)</th>
                        <th>Ubicación</th>
                        <th class="text-end">Acción</th>
                    </tr>
                    </thead>
                    <tbody>
                    {# Loop through all VisitaHospitalaria entities where estado == 'ACTIVA' #}
                    {% for visita in entities %}
                        <tr>
                            <td>
                                <span class="fw-bold text-success"><i class="bi bi-box-arrow-in-right"></i> {{ visita.fechaHoraEntrada|date('H:i') }}</span><br>
                                <small class="text-muted">{{ visita.fechaHoraEntrada|time_ago }}</small>
                            </td>
                            <td>
                                <strong>{{ visita.nombreVisitante }}</strong><br>
                                <small class="text-muted">CI: {{ visita.identificacionVisitante|number_format(0, ',', '.') }}</small>
                            </td>
                            <td><span class="badge bg-secondary">{{ visita.parentesco }}</span></td>
                            <td>{{ visita.hospitalizacion.paciente.nombre }} {{ visita.hospitalizacion.paciente.apellido }}</td>
                            <td>
                                {{ visita.hospitalizacion.camaActual.habitacion.area.nombre }}<br>
                                <strong>Hab: {{ visita.hospitalizacion.camaActual.habitacion.nombre }}</strong>
                            </td>
                            <td class="text-end">
                                <form action="{{ path('app_visitas_marcar_salida', {'id': visita.id}) }}"
                                      method="POST"
                                      data-controller="confirm-finalizar"
                                      data-action="submit->confirm-finalizar#confirm"
                                      data-confirm-finalizar-title-value="¿Marcar Salida?"
                                      data-confirm-finalizar-text-value="¿Desea marcar la salida de esta persona '{{ visita.nombreVisitante }}'?"
                                      data-confirm-finalizar-confirm-button-text-value="Sí, marcar">

                                    <input type="hidden" name="_token" value="{{ csrf_token('checkout' ~ visita.id) }}">

                                    <button type="submit" class="btn btn-outline-danger btn-sm shadow-sm" title="Marcar Salida">
                                        <i class="bi bi-box-arrow-right"></i> Marcar Salida
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal Nuevo Visitante -->
    <div class="modal fade" id="newVisitorModal" tabindex="-1" aria-labelledby="newVisitorModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="newVisitorModalLabel"><i class="bi bi-search"></i> Seleccionar Paciente</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="{{ path('app_visitas_pre_registrar') }}" method="POST">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label for="paciente_id" class="form-label fw-bold">Paciente Hospitalizado</label>
                            <!-- ajaxSrchSelect already initialized globally in app.js -->
                            <select name="paciente_id" id="paciente_id" class="ajaxSrchSelect" style="width: 100%" required>
                                <option value="">Buscar paciente...</option>
                            </select>
                            <div class="form-text mt-2">
                                Ingrese el nombre o cédula. Si el paciente no tiene un ingreso activo, no podrá registrar visitas.
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Siguiente <i class="bi bi-arrow-right"></i></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
