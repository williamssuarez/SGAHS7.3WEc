<div class="row g-4">

    {# LEFT COLUMN: Profile Card #}
    <div class="col-md-4">
        <div class="card card-primary card-outline shadow-sm h-100">
            <div class="card-body text-center mt-4">

                {# Profile Picture #}
                {% if user.avatarUrl is empty %}
                    {% set final_src = asset('build/assets/img/user2-160x160.jpg') %}
                {% elseif user.avatarUrl starts with 'http' %}
                    {% set final_src = user.avatarUrl %}
                {% else %}
                    {% set full_photo_path = paciente_photo_path ~ user.avatarUrl %}
                    {% set final_src = asset(full_photo_path) | imagine_filter('patient_profile') %}
                {% endif %}
                {% set avatar = final_src %}

                <div class="mb-4">
                    <img
                        src="{{ asset(avatar) }}"
                        class="rounded-circle img-thumbnail shadow-sm"
                        alt="Foto de Perfil"
                        style="width: 150px; height: 150px; object-fit: cover;">
                </div>

                <h3 class="fw-bold mb-1">{{ profile.nombre|default('Nombre') }} {{ profile.apellido|default('No registrado') }}</h3>
                <p class="text-muted mb-3"><i class="bi bi-person-badge"></i> CI / Doc: <strong>{{ profile.nroDocumento|default('No registrado') }}</strong></p>

                <div class="d-flex justify-content-center gap-2 mb-4">
                    {{ user.status|status_badge }}
                </div>
                
                <div class="d-flex flex-wrap justify-content-center gap-1 mb-4">
                    {% for badge in user.roles|user_badges %}
                        <span class="badge rounded-pill {{ badge.class }}">
                            {{ badge.label }}
                        </span>
                    {% endfor %}
                </div>

            </div>
            
            {% if show_edit_button|default(false) %}
            <div class="card-footer bg-white text-center">
                <a href="{{ path('app_user_internal_edit', {'id': user.id}) }}" class="btn btn-primary shadow-sm w-100">
                    <i class="bi bi-pencil-square"></i> Editar Perfil
                </a>
            </div>
            {% endif %}
        </div>
    </div>

    {# RIGHT COLUMN: Detailed Information #}
    <div class="col-md-8">
        <div class="card shadow-sm h-100 border-0">
            <div class="card-header bg-light border-bottom">
                <h5 class="card-title mb-0 fw-bold text-secondary">
                    <i class="bi bi-info-circle"></i> Información General
                </h5>
            </div>
            <div class="card-body p-4">

                <div class="row g-4">
                    {# Account Details #}
                    <div class="col-sm-6">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Correo Electrónico</small>
                        <p class="fs-5 mb-0"><i class="bi bi-envelope text-primary me-2"></i>
                            {{ user.email }}
                            {% if user.isVerified %}
                                <i class="bi bi-check-circle-fill" style="color: #138b00"></i>
                            {% else %}
                                <i class="bi bi-x-circle-fill" style="color: #8b0000"></i>
                            {% endif %}
                        </p>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Teléfono</small>
                        <p class="fs-5 mb-0"><i class="bi bi-telephone text-primary me-2"></i> {{ profile.telefono|default('No registrado') }}</p>
                    </div>

                    <div class="col-12"><hr class="text-muted my-2"></div>

                    {# Especialidades #}
                    {% if profile.especialidades is defined and profile.especialidades|length > 0 %}
                    <div class="col-12">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Especialidades Médicas</small>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            {% for especialidad in profile.especialidades %}
                                <span class="badge bg-info text-dark fs-6"><i class="bi bi-star-fill text-warning me-1"></i> {{ especialidad.nombre }}</span>
                            {% endfor %}
                        </div>
                    </div>
                    
                    <div class="col-12"><hr class="text-muted my-2"></div>
                    {% endif %}

                    {# Address #}
                    <div class="col-12">
                        <small class="text-muted text-uppercase fw-bold d-block mb-1">Dirección de Residencia</small>
                        <p class="fs-5 mb-0">
                            <i class="bi bi-geo-alt text-primary me-2"></i>
                            {% if profile.sector %}
                                {{ profile.sector.displayFullLocation }}
                            {% endif %}
                            {{ profile.direccion|default('No se ha proporcionado una dirección de residencia.') }}
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>
