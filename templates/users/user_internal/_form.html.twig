{{ form_start(form, {
    'attr': {
        'data-controller': 'submit-once cascading-location role-toggle',
        'data-action': 'submit->submit-once#disable'
    }
}) }}
{{ include('base/_form_error_messages.html.twig') }}

{# 1. Navegación Segmentada del Asistente (Preserva IDs para assets/app.js) #}
<ul class="nav nav-pills apple-segmented-steps" id="formTab" role="tablist">
    <li class="nav-item flex-fill" role="presentation">
        <button class="nav-link active w-100" id="tab1" data-bs-toggle="tab" data-bs-target="#tab1-pane" type="button" role="tab" aria-controls="tab1-pane" aria-selected="true">
            <i class="bi bi-shield-lock-fill"></i>
            <span class="apple-tab-num">1</span>
            <span class="apple-tab-title">1. Credenciales</span>
        </button>
    </li>
    <li class="nav-item flex-fill" role="presentation">
        <button class="nav-link w-100" id="tab2" data-bs-toggle="tab" data-bs-target="#tab2-pane" type="button" role="tab" aria-controls="tab2-pane" aria-selected="false">
            <i class="bi bi-person-vcard-fill"></i>
            <span class="apple-tab-num">2</span>
            <span class="apple-tab-title">2. Datos del Usuario</span>
        </button>
    </li>
    <li class="nav-item flex-fill" role="presentation">
        <button class="nav-link w-100" id="tab3" data-bs-toggle="tab" data-bs-target="#tab3-pane" type="button" role="tab" aria-controls="tab3-pane" aria-selected="false">
            <i class="bi bi-geo-alt-fill"></i>
            <span class="apple-tab-num">3</span>
            <span class="apple-tab-title">3. Contacto y Residencia</span>
        </button>
    </li>
</ul>

{# 2. Barra de Progreso Discreta (4px) #}
<div class="progress apple-wizard-progress" role="progressbar" aria-label="Progreso del formulario" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
    <div id="form-progress-bar" class="progress-bar" style="width: 0%;"></div>
</div>

{# 3. Contenido de Pasos #}
<div class="tab-content pt-2" id="formTabContent">

    {# PASO 1: Credenciales de la Cuenta #}
    <div class="tab-pane fade show active" id="tab1-pane" role="tabpanel" aria-labelledby="tab1" tabindex="0">
        <div class="apple-step-header mb-4">
            <h5 class="fw-bold m-0 text-primary d-flex align-items-center gap-2">
                <i class="bi bi-shield-lock"></i> Credenciales de la Cuenta
            </h5>
            <p class="text-muted small m-0">Define los datos de acceso, roles institucionales y fotografía de perfil.</p>
        </div>

        {# Apple ID Avatar Uploader #}
        {% set existing_avatar = null %}
        {% if form.vars.data and form.vars.data.avatarUrl is not empty %}
            {% if form.vars.data.avatarUrl starts with 'http' %}
                {% set existing_avatar = form.vars.data.avatarUrl %}
            {% else %}
                {% set full_photo_path = paciente_photo_path ~ form.vars.data.avatarUrl %}
                {% set existing_avatar = asset(full_photo_path) | imagine_filter('patient_profile') %}
            {% endif %}
        {% endif %}

        <div class="apple-form-section text-center pt-2 pb-4">
            <div data-controller="avatar-upload" class="apple-avatar-uploader">
                <div class="apple-avatar-circle shadow-sm"
                     data-action="click->avatar-upload#clickAvatar"
                     title="Haz clic para seleccionar tu foto de perfil">

                    <div data-avatar-upload-target="placeholder" class="apple-avatar-placeholder {{ existing_avatar ? 'd-none' : '' }}">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <img data-avatar-upload-target="preview"
                         class="apple-avatar-preview {{ existing_avatar ? '' : 'd-none' }}"
                         src="{{ existing_avatar|default('') }}"
                         alt="Foto de perfil seleccionada">

                    <div class="apple-avatar-badge">
                        <i class="bi bi-camera-fill"></i>
                    </div>
                </div>

                {{ form_widget(form.avatarUrl, {
                    'attr': {
                        'class': 'd-none',
                        'accept': 'image/jpeg,image/png',
                        'data-avatar-upload-target': 'input',
                        'data-action': 'change->avatar-upload#fileChanged'
                    }
                }) }}

                <button type="button"
                        class="apple-avatar-remove-btn {{ existing_avatar ? '' : 'd-none' }}"
                        data-avatar-upload-target="removeBtn"
                        data-action="click->avatar-upload#remove">
                    <i class="bi bi-x-circle me-1"></i> Quitar foto
                </button>

                <div class="apple-avatar-hint">
                    Fotografía institucional (Opcional) · JPG o PNG, máx. 2 MB
                </div>
                <div data-avatar-upload-target="errorMsg" class="apple-field-error text-center mt-1 d-none"></div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="apple-form-group mb-3">
                    <label class="apple-input-label" for="{{ form.email.vars.id }}">
                        Correo Electrónico <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.email, {
                        'attr': {
                            'class': 'apple-text-input',
                            'placeholder': 'ejemplo@hospital.gob.ve'
                        }
                    }) }}
                </div>
            </div>

            <div class="col-md-6">
                <div class="apple-form-group mb-3">
                    <label class="apple-input-label" for="{{ form.roles.vars.id }}">
                        Roles de Usuario <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.roles, {
                        'attr': {
                            'class': 'form-select srchSelect w-100',
                            'data-role-toggle-target': 'rolesSelect',
                            'data-placeholder': 'Seleccione los roles...'
                        }
                    }) }}
                </div>
            </div>
        </div>
    </div>

    {# PASO 2: Datos del Usuario #}
    <div class="tab-pane fade" id="tab2-pane" role="tabpanel" aria-labelledby="tab2" tabindex="0">
        <div class="apple-step-header mb-4">
            <h5 class="fw-bold m-0 text-primary d-flex align-items-center gap-2">
                <i class="bi bi-person-vcard"></i> Datos del Usuario
            </h5>
            <p class="text-muted small m-0">Información de identificación personal y profesional del miembro del equipo.</p>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="apple-form-group mb-3">
                    <label class="apple-input-label" for="{{ form.internalProfile.nombre.vars.id }}">
                        Nombres <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.internalProfile.nombre, {
                        'attr': {
                            'class': 'apple-text-input',
                            'placeholder': 'Primer y segundo nombre'
                        }
                    }) }}
                </div>
            </div>

            <div class="col-md-6">
                <div class="apple-form-group mb-3">
                    <label class="apple-input-label" for="{{ form.internalProfile.apellido.vars.id }}">
                        Apellidos <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.internalProfile.apellido, {
                        'attr': {
                            'class': 'apple-text-input',
                            'placeholder': 'Primer y segundo apellido'
                        }
                    }) }}
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="apple-form-group mb-3">
                    <label class="apple-input-label" for="{{ form.internalProfile.nroDocumento.vars.id }}">
                        Documento de Identidad <span class="text-danger">*</span>
                    </label>
                    <div class="apple-composite-group">
                        <div class="apple-composite-prefix apple-composite-prefix-doc">
                            {{ form_widget(form.internalProfile.tipoDocumento, {
                                'attr': {
                                    'class': 'noSrchSelect form-select w-100'
                                }
                            }) }}
                        </div>
                        <div class="apple-composite-input">
                            {{ form_widget(form.internalProfile.nroDocumento, {
                                'attr': {
                                    'class': 'apple-text-input number-only',
                                    'placeholder': 'Ej. 12345678',
                                    'inputmode': 'numeric',
                                    'maxlength': '9'
                                }
                            }) }}
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6" data-role-toggle-target="especialidadesContainer">
                <div class="apple-form-group mb-3">
                    <label class="apple-input-label" for="{{ form.internalProfile.especialidades.vars.id }}">
                        Especialidades Médicas
                    </label>
                    {{ form_widget(form.internalProfile.especialidades, {
                        'attr': {
                            'class': 'form-select srchSelect w-100',
                            'data-placeholder': 'Seleccione especialidades...'
                        }
                    }) }}
                </div>
            </div>
        </div>
    </div>

    {# PASO 3: Contactos y Direcciones #}
    <div class="tab-pane fade" id="tab3-pane" role="tabpanel" aria-labelledby="tab3" tabindex="0">
        <div class="apple-step-header mb-4">
            <h5 class="fw-bold m-0 text-primary d-flex align-items-center gap-2">
                <i class="bi bi-geo-alt"></i> Contacto y Residencia
            </h5>
            <p class="text-muted small m-0">Ubicación física y números de teléfono para contacto y notificaciones.</p>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="apple-form-group mb-3">
                    <label class="apple-input-label" for="{{ form.internalProfile.telefono.number.vars.id }}">
                        Teléfono Móvil <span class="text-danger">*</span>
                    </label>
                    <div class="apple-composite-group">
                        <div class="apple-composite-prefix apple-composite-prefix-phone">
                            {{ form_widget(form.internalProfile.telefono.prefix, {
                                'attr': {
                                    'class': 'noSrchSelect form-select w-100'
                                }
                            }) }}
                        </div>
                        <div class="apple-composite-input">
                            {{ form_widget(form.internalProfile.telefono.number, {
                                'attr': {
                                    'class': 'apple-text-input number-only',
                                    'placeholder': '1234567',
                                    'inputmode': 'numeric',
                                    'maxlength': '7'
                                }
                            }) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Cascada Geográfica en 2 Columnas #}
        <div class="row g-3">
            <div class="col-md-6">
                <div class="apple-form-group mb-3">
                    <label class="apple-input-label" for="{{ form.internalProfile.location.estado.vars.id }}">
                        Estado <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.internalProfile.location.estado, {
                        'attr': {'class': 'form-select srchSelect w-100'}
                    }) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="apple-form-group mb-3">
                    <label class="apple-input-label" for="{{ form.internalProfile.location.municipio.vars.id }}">
                        Municipio <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.internalProfile.location.municipio, {
                        'attr': {'class': 'form-select srchSelect w-100'}
                    }) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="apple-form-group mb-3">
                    <label class="apple-input-label" for="{{ form.internalProfile.location.parroquia.vars.id }}">
                        Parroquia <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.internalProfile.location.parroquia, {
                        'attr': {'class': 'form-select srchSelect w-100'}
                    }) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="apple-form-group mb-3">
                    <label class="apple-input-label" for="{{ form.internalProfile.location.sector.vars.id }}">
                        Sector <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.internalProfile.location.sector, {
                        'attr': {'class': 'form-select srchSelect w-100'}
                    }) }}
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-12">
                <div class="apple-form-group mb-3">
                    <label class="apple-input-label" for="{{ form.internalProfile.direccion.vars.id }}">
                        Dirección Detallada <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.internalProfile.direccion, {
                        'attr': {
                            'class': 'apple-text-input apple-textarea',
                            'rows': 3,
                            'placeholder': 'Avenida, calle, piso/apartamento o punto de referencia...'
                        }
                    }) }}
                </div>
            </div>
        </div>
    </div>
</div>

{# 4. Barra de Acciones y Navegación (IDs requeridos por assets/app.js) #}
<div class="apple-form-wizard-actions pt-4 mt-4 border-top" id="btnToolbar">
    <div class="apple-wizard-buttons-grid">
        <button id="prev-tab" class="btn btn-outline-secondary apple-spring rounded-pill px-4 py-2 btn-prev" type="button" disabled="disabled">
            <i class="bi bi-arrow-left me-2"></i> Anterior
        </button>
        <a href="{{ path('app_user_internal_index') }}" class="btn btn-link text-decoration-none apple-spring px-3 py-2 text-muted btn-cancel">
            Cancelar
        </a>
        <button id="next-tab" class="btn btn-primary apple-btn-primary apple-spring rounded-pill px-4 py-2 btn-next" type="button">
            Siguiente <i class="bi bi-arrow-right ms-2"></i>
        </button>
        <button id="submit-form" type="submit" class="btn btn-primary apple-btn-primary apple-spring rounded-pill px-4 py-2 btn-submit" data-submit-once-target="submitButton" style="display:none;">
            <i class="bi bi-check2-circle me-2"></i> {{ button_label|default('Guardar Usuario') }}
        </button>
    </div>
</div>
{{ form_end(form) }}
