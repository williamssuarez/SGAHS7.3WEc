{% extends 'base.html.twig' %}

{% block title %}Nuevo Usuario Interno{% endblock %}

{% block titlewrap %}
    Nuevo Usuario Interno
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_user_internal_index') }}">Usuarios Internos</a></li>
    <li class="breadcrumb-item active" aria-current="page">Nuevo Usuario</li>
{% endblock %}

{% block body %}
    <div class="apple-portal-container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8 col-xl-7">
                <div class="apple-form-card shadow-sm mb-4">
                    <div class="form-header-group d-flex align-items-center gap-3">
                        <div class="apple-header-icon-badge">
                            <i class="bi bi-person-plus-fill"></i>
                        </div>
                        <div>
                            <h3 class="form-header-title m-0">Registrar Usuario Interno</h3>
                            <p class="form-header-subtitle">Completa los 3 pasos para dar de alta al nuevo miembro del equipo hospitalario.</p>
                        </div>
                    </div>

                    {{ include('users/user_internal/_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
