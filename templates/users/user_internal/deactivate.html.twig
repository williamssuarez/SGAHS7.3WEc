{% extends 'base.html.twig' %}

{% block title %}Desactivar Perfil de Usuario Interno{% endblock %}

{% block titlewrap %}
    Desactivar Perfil de Usuario Interno
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_user_internal_index') }}">Usuarios Internos</a></li>
    {% set current_user = user_internal|default(user|default(null)) %}
    {% if current_user and current_user.id is defined %}
        <li class="breadcrumb-item"><a href="{{ path('app_user_internal_show', {'id': current_user.id}) }}">{{ current_user.internalProfile.nombre|default('Usuario') }}</a></li>
    {% endif %}
    <li class="breadcrumb-item active" aria-current="page">Desactivar</li>
{% endblock %}

{% block body %}
    <div class="apple-portal-container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8 col-xl-7">
                {{ include('users/user_external/_admin_audit.html.twig', {
                    'back_url': path('app_user_internal_index'),
                    'button_label': 'Desactivar Cuenta'
                }) }}
            </div>
        </div>
    </div>
{% endblock %}
