{% extends 'base.html.twig' %}

{% block title %}Mi Perfil{% endblock %}

{% block titlewrap %}
    Mi Perfil Institucional
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_index') }}">Inicio</a></li>
    <li class="breadcrumb-item active" aria-current="page">Mi Perfil</li>
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="apple-alert apple-alert-{{ label == 'error' or label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} alert-dismissible fade show mb-4" role="alert">
                <i class="bi {{ label == 'error' or label == 'danger' ? 'bi-exclamation-octagon-fill' : (label == 'warning' ? 'bi-exclamation-triangle-fill' : 'bi-check-circle-fill') }} me-2"></i>
                <div class="flex-grow-1">{{ message }}</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="container-fluid px-0">
        {{ include('users/user_internal/_show.html.twig', {'profile': profile, 'show_edit_button': false}) }}
    </div>
{% endblock %}
