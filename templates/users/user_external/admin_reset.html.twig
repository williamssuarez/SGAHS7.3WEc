{% extends 'base.html.twig' %}

{% block title %}Forzar Reinicio de Clave{% endblock %}

{% block titlewrap %}
    Forzar Reinicio de Clave
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_user_external_index') }}">Usuarios Externos</a></li>
    {% set current_user = target_user|default(user|default(null)) %}
    {% if current_user and current_user.id is defined %}
        <li class="breadcrumb-item"><a href="{{ path('app_user_external_show', {'id': current_user.id}) }}">{{ current_user.externalProfile.nombre|default('Usuario') }}</a></li>
    {% endif %}
    <li class="breadcrumb-item active" aria-current="page">Reinicio de Clave</li>
{% endblock %}

{% block body %}
    <div class="apple-portal-container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8 col-xl-7">
                <div class="apple-form-card shadow-sm">
                    {{ form_start(form, {
                        'attr': {
                            'data-controller': 'submit-once',
                            'data-action': 'submit->submit-once#disable'
                        }
                    }) }}
                    {{ include('base/_form_error_messages.html.twig') }}

                    <div class="apple-alert apple-alert-warning mb-4 d-flex align-items-start gap-3">
                        <i class="bi bi-envelope-exclamation fs-3 mt-1 text-warning"></i>
                        <div>
                            <h5 class="fw-bold mb-1">Enviar Enlace de Recuperación</h5>
                            <p class="small mb-0 opacity-75">
                                Está a punto de invalidar la sesión actual del usuario <strong>{{ target_user.email }}</strong> y enviarle un enlace seguro a su correo electrónico para establecer una nueva contraseña.
                            </p>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-12">
                            <div class="apple-form-group mb-3">
                                <label class="apple-input-label" for="{{ form.password.vars.id }}">
                                    Clave de Administrador <span class="text-danger">*</span>
                                </label>
                                <div class="apple-input-wrap" data-controller="password-toggle">
                                    {{ form_widget(form.password, {
                                        'attr': {
                                            'class': 'apple-text-input',
                                            'placeholder': 'Ingresa tu clave de administrador para autorizar',
                                            'data-password-toggle-target': 'input',
                                            'autocomplete': 'current-password'
                                        }
                                    }) }}
                                    <button type="button"
                                            class="apple-input-action-btn apple-spring"
                                            data-action="click->password-toggle#toggle"
                                            tabindex="-1"
                                            title="Mostrar u ocultar contraseña"
                                            aria-label="Mostrar u ocultar contraseña">
                                        <i class="bi bi-eye-fill" data-password-toggle-target="icon"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="apple-form-group mb-3">
                                <label class="apple-input-label" for="{{ form.reason.vars.id }}">
                                    Motivo del Reinicio <span class="text-danger">*</span>
                                </label>
                                {{ form_widget(form.reason, {
                                    'attr': {
                                        'class': 'apple-text-input apple-textarea',
                                        'rows': 4,
                                        'placeholder': 'Explica detalladamente el motivo institucional para enviar el reinicio de clave...'
                                    }
                                }) }}
                            </div>
                        </div>
                    </div>

                    <div class="apple-form-actions d-flex flex-wrap justify-content-between align-items-center gap-3 pt-4 mt-4 border-top">
                        <a href="{{ path('app_user_external_index') }}" class="btn btn-outline-secondary apple-spring rounded-pill px-4 py-2">
                            <i class="bi bi-arrow-left me-2"></i> Cancelar
                        </a>

                        <button type="submit" class="btn btn-primary apple-btn-primary apple-spring rounded-pill px-4 py-2" data-submit-once-target="submitButton">
                            <i class="bi bi-send me-2"></i> Enviar Enlace de Recuperación
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
