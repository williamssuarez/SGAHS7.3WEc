{% extends 'base.html.twig' %}

{% block title %}Gestion de Usuarios Externos{% endblock %}

{% block titlewrap %}
    Usuarios
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">Usuarios</li>
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

<div class="card card-primary card-outline">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title m-0">Usuarios Registrados</h3>
        <span class="text-muted small ms-auto"><i class="bi bi-info-circle"></i> Puedes buscar por <strong>Nombre o Email</strong></span>
    </div>

    <div class="card-body">
        <div class="dtHereServer table-responsive" data-dt-config="{{ datatable_settings(datatable)|escape('html_attr') }}">
            Cargando usuarios...
        </div>
    </div>
</div>
{% endblock %}
