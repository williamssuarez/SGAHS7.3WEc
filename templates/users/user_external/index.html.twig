{% extends 'base.html.twig' %}

{% block title %}Gestión de Usuarios Externos{% endblock %}

{% block titlewrap %}
    Gestión de Usuarios Externos
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">Usuarios Externos</li>
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="apple-alert apple-alert-{{ label == 'error' or label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} alert-dismissible fade show mb-4" role="alert">
                <i class="bi {{ label == 'error' or label == 'danger' ? 'bi-exclamation-octagon-fill' : (label == 'warning' ? 'bi-exclamation-triangle-fill' : 'bi-check-circle-fill') }} me-2"></i>
                <div class="flex-grow-1">{{ message }}</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="apple-table-card shadow-sm mb-4">
        <div class="apple-table-header d-flex flex-wrap justify-content-between align-items-center gap-3 pb-3 mb-3 border-bottom">
            <div class="d-flex align-items-center gap-3">
                <div class="apple-header-icon-badge">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <h3 class="apple-table-title m-0">Pacientes y Usuarios Externos</h3>
                    <p class="apple-table-subtitle text-muted small m-0">
                        <i class="bi bi-info-circle me-1"></i> Puedes buscar por <strong>Nombre</strong> o <strong>Correo Electrónico</strong>
                    </p>
                </div>
            </div>
            <div>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 small">
                    <i class="bi bi-shield-lock me-1"></i> Módulo Administrativo
                </span>
            </div>
        </div>

        <div class="apple-table-body">
            <div class="dtHereServer table-responsive" data-dt-config="{{ datatable_settings(datatable)|escape('html_attr') }}">
                <div class="text-center py-5 text-muted">
                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                    Cargando usuarios...
                </div>
            </div>
        </div>
    </div>
{% endblock %}
