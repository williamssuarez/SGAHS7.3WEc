{% extends 'base.html.twig' %}

{% block title %}Perfil de Usuario Externo{% endblock %}

{% block titlewrap %}
    Detalles del Usuario
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_user_external_index') }}">Usuarios</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ profile.nombre|default('Usuario') }}</li>
{% endblock %}

{% block body %}
    <div class="container-fluid px-0">
        {{ include('users/user_external/_show.html.twig') }}

        {# Bottom Actions (Navigation) #}
        <div class="mt-4">
            <a href="{{ path('app_user_external_index') }}" class="btn btn-outline-secondary shadow-sm px-4">
                <i class="bi bi-arrow-left"></i> Volver a la lista
            </a>
        </div>
    </div>
{% endblock %}
