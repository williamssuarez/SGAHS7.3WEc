{% extends 'base.html.twig' %}

{% block title %}Perfil de Usuario Externo{% endblock %}

{% block titlewrap %}
    Detalles de Usuario Externo
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('app_user_external_index') }}">Usuarios Externos</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ profile.nombre|default('Usuario') }} {{ profile.apellido|default('') }}</li>
{% endblock %}

{% block body %}
    <div class="apple-portal-container">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="apple-alert apple-alert-{{ label == 'error' or label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} alert-dismissible fade show mb-4" role="alert">
                    <i class="bi {{ label == 'error' or label == 'danger' ? 'bi-exclamation-octagon-fill' : (label == 'warning' ? 'bi-exclamation-triangle-fill' : 'bi-check-circle-fill') }} me-2"></i>
                    <div class="flex-grow-1">{{ message }}</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {{ include('users/user_external/_show.html.twig', {'show_edit_button': true}) }}

        <div class="mt-4 pt-2">
            <a href="{{ path('app_user_external_index') }}" class="btn btn-outline-secondary apple-spring rounded-pill px-4 py-2">
                <i class="bi bi-arrow-left me-2"></i> Volver a la lista
            </a>
        </div>
    </div>
{% endblock %}
