{{ form_start(form, {
    'attr': {
        'data-controller': 'submit-once',
        'data-action': 'submit->submit-once#disable'
    }
}) }}
{{ include('base/_form_error_messages.html.twig') }}

<div class="apple-form-card shadow-sm">
    <div class="apple-alert apple-alert-warning mb-4 d-flex align-items-start gap-3">
        <i class="bi bi-shield-exclamation fs-3 mt-1 text-warning"></i>
        <div>
            <h5 class="fw-bold mb-1">Auditoría de Seguridad Requerida</h5>
            <p class="small mb-0 opacity-75">
                Esta acción administrativa afectará el acceso de la cuenta del usuario y quedará registrada formalmente en la bitácora de auditoría del sistema con fines de trazabilidad y seguridad institucional.
            </p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <div class="apple-form-group mb-3">
                <label class="apple-input-label" for="{{ form.password.vars.id }}">
                    Clave de Administrador <span class="text-danger">*</span>
                </label>
                <div class="apple-input-wrap" data-controller="password-toggle">
                    {{ form_widget(form.password, {
                        'attr': {
                            'class': 'apple-text-input',
                            'placeholder': 'Ingresa tu clave de administrador para autorizar',
                            'data-password-toggle-target': 'input',
                            'autocomplete': 'current-password'
                        }
                    }) }}
                    <button type="button"
                            class="apple-input-action-btn apple-spring"
                            data-action="click->password-toggle#toggle"
                            tabindex="-1"
                            title="Mostrar u ocultar contraseña"
                            aria-label="Mostrar u ocultar contraseña">
                        <i class="bi bi-eye-fill" data-password-toggle-target="icon"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="apple-form-group mb-3">
                <label class="apple-input-label" for="{{ form.reason.vars.id }}">
                    Motivo de la Acción <span class="text-danger">*</span>
                </label>
                {{ form_widget(form.reason, {
                    'attr': {
                        'class': 'apple-text-input apple-textarea',
                        'rows': 4,
                        'placeholder': 'Explica detalladamente el motivo institucional para esta acción administrativa...'
                    }
                }) }}
            </div>
        </div>
    </div>

    <div class="apple-form-actions d-flex flex-wrap justify-content-between align-items-center gap-3 pt-4 mt-4 border-top">
        <a href="{{ back_url|default(path('app_user_external_index')) }}" class="btn btn-outline-secondary apple-spring rounded-pill px-4 py-2">
            <i class="bi bi-arrow-left me-2"></i> Volver a la lista
        </a>

        <button type="submit" class="btn btn-primary apple-btn-primary apple-spring rounded-pill px-4 py-2" data-submit-once-target="submitButton">
            <i class="bi bi-shield-check me-2"></i> {{ button_label|default('Confirmar Acción') }}
        </button>
    </div>
</div>
{{ form_end(form) }}
