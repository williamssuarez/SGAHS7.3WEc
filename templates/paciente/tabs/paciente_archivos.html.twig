<div class="apple-section">
    <div class="apple-section-header">
        <h5 class="text-body">
            <i class="bi bi-folder-fill text-primary me-2"></i> Documentos y Estudios Adjuntos
        </h5>
        <a class="btn btn-primary apple-btn-primary btn-sm rounded-pill px-3 shadow-xs d-inline-flex align-items-center gap-1"
           href="{{ path('app_attachment_paciente_upload', {'id': paciente.id}) }}"
           data-controller="apple-spring">
            <i class="bi bi-cloud-arrow-up"></i>
            <span>Subir Documento</span>
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle dtHere">
            <thead>
                <tr class="text-secondary small text-uppercase">
                    <th>#</th>
                    <th>Documento</th>
                    <th>Formato</th>
                    <th>Fecha de Carga</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            {% for entity in paciente.attachments %}
                {% set isImage = (entity.fileType == 'image/jpeg' or entity.fileType == 'image/png') %}
                {% set isPdf = (entity.fileType == 'application/pdf') %}
                {% set viewUrl = path('app_attachment_download', {'id': entity.id}) %}
                {% set downloadUrl = path('app_attachment_download', {'id': entity.id, 'download': 1}) %}
                <tr>
                    <td class="text-muted small">{{ loop.index }}</td>
                    <td class="fw-semibold">
                        <div class="d-flex align-items-center">
                            {% if isImage %}
                                <div class="apple-file-thumb-wrap me-3"
                                     data-controller="apple-image-viewer"
                                     data-apple-image-viewer-url-value="{{ viewUrl }}"
                                     data-apple-image-viewer-title-value="{{ entity.fileName }}"
                                     data-apple-image-viewer-download-url-value="{{ downloadUrl }}"
                                     data-action="click->apple-image-viewer#open"
                                     title="Clic para ampliar imagen en visor interactivo">
                                    <img src="{{ viewUrl }}"
                                         alt="{{ entity.fileName }}"
                                         class="apple-file-thumb"
                                         loading="lazy"
                                         data-apple-image-viewer-target="thumb">
                                    <span class="thumb-zoom-icon"><i class="bi bi-zoom-in"></i></span>
                                </div>
                            {% elseif isPdf %}
                                <div class="apple-file-icon-wrap me-3 text-danger">
                                    <i class="bi bi-file-earmark-pdf fs-4"></i>
                                </div>
                            {% else %}
                                <div class="apple-file-icon-wrap me-3 text-secondary">
                                    <i class="bi bi-file-earmark-text fs-4"></i>
                                </div>
                            {% endif %}
                            <div>
                                <div class="text-body text-break">{{ entity.fileName }}</div>
                            </div>
                        </div>
                    </td>
                    <td>
                        {% if isPdf %}
                            <span class="apple-role-pill text-bg-danger">PDF</span>
                        {% elseif isImage %}
                            <span class="apple-role-pill text-bg-success">IMAGEN</span>
                        {% else %}
                            <span class="apple-role-pill">ARCHIVO</span>
                        {% endif %}
                    </td>
                    <td class="text-secondary small">
                        {{ entity.dateUploaded|date('d/m/Y') }}
                    </td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            {% if isImage %}
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-xs"
                                        data-controller="apple-image-viewer apple-spring"
                                        data-apple-image-viewer-url-value="{{ viewUrl }}"
                                        data-apple-image-viewer-title-value="{{ entity.fileName }}"
                                        data-apple-image-viewer-download-url-value="{{ downloadUrl }}"
                                        data-action="click->apple-image-viewer#open">
                                    <i class="bi bi-arrows-fullscreen me-1"></i> Ver Imagen
                                </button>
                                <a class="btn btn-sm btn-outline-secondary rounded-circle shadow-xs"
                                   href="{{ downloadUrl }}"
                                   title="Descargar imagen"
                                   data-controller="apple-spring">
                                    <i class="bi bi-download"></i>
                                </a>
                            {% elseif isPdf %}
                                <a class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-xs"
                                   href="{{ viewUrl }}"
                                   target="_blank"
                                   data-controller="apple-spring">
                                    <i class="bi bi-file-earmark-pdf me-1"></i> Ver PDF
                                </a>
                                <a class="btn btn-sm btn-outline-secondary rounded-circle shadow-xs"
                                   href="{{ downloadUrl }}"
                                   title="Descargar PDF"
                                   data-controller="apple-spring">
                                    <i class="bi bi-download"></i>
                                </a>
                            {% else %}
                                <a class="btn btn-sm btn-outline-secondary rounded-pill px-3 shadow-xs"
                                   href="{{ downloadUrl }}"
                                   data-controller="apple-spring">
                                    <i class="bi bi-download me-1"></i> Descargar
                                </a>
                            {% endif %}

                            <button class="btn btn-sm btn-outline-danger rounded-circle shadow-xs"
                                    title="Eliminar documento"
                                    data-controller="apple-spring"
                                    onclick="deleteFile(
                                        '{{ path('app_attachment_delete', {'id': entity.id}) }}',
                                        '{{ csrf_token('delete' ~ entity.id) }}'
                                        )">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
