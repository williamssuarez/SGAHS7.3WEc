<div class="apple-section">
    <div class="apple-section-header">
        <h5 class="text-body"><i class="fa-solid fa-head-side-cough text-secondary me-2"></i> Diagnósticos y Enfermedades</h5>
        <small class="text-secondary">Historial nosológico</small>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle dtHere">
            <thead>
                <tr class="text-secondary small text-uppercase">
                    <th>Enfermedad</th>
                    <th>Diagnóstico</th>
                    <th>Tipo</th>
                    <th>Crónica</th>
                    <th>Notas</th>
                </tr>
            </thead>
            <tbody>
            {% for entity in enfermedades %}
                <tr>
                    <td class="fw-semibold text-primary">{{ entity.enfermedad.nombre }}</td>
                    <td class="text-nowrap">{{ entity.fechaDiagnostico|date('d/m/Y', false) }}</td>
                    <td>
                        {% set badge = entity.pacienteEnfermedadesTiposBadgeConfig %}
                        <span class="apple-role-pill {{ badge.class }}">
                            {{ badge.label }}
                        </span>
                    </td>
                    <td>
                        {% if entity.cronica %}
                            <span class="apple-role-pill text-bg-warning">Sí</span>
                        {% else %}
                            <span class="apple-role-pill">No</span>
                        {% endif %}
                    </td>
                    <td class="small text-secondary">{{ entity.notas ? entity.notas : '--' }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
