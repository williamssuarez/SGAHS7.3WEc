{% if column.name == 'foto' %}
    {% if row.foto %}
        <img
            src="{{ asset(paciente_photo_path ~ row.foto) | imagine_filter('patient_thumb') }}"
            alt="{{ row.nombre }} Thumbnail Photo"
            class="rounded-circle shadow-xs border border-secondary-subtle object-fit-cover"
            style="width: 40px; height: 40px;"
        >
    {% else %}
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle" style="width: 40px; height: 40px;">
            <i class="bi bi-person-fill"></i>
        </div>
    {% endif %}

{% elseif column.name == 'cedula' %}
    <span class="apple-role-pill">
        <i class="bi bi-person-vcard"></i>
        {{ row.tipoDocumento }}-{{ row.cedula|number_format(0, ',', '.') }}
    </span>

{% elseif column.name == 'acciones' %}
    <div class="btn-group btn-group-sm rounded-pill shadow-sm" role="group" aria-label="Acciones">
        <a href="{{ path('app_paciente_show', {'id': row.id}) }}"
           class="btn btn-outline-secondary px-2"
           title="Ver Detalles"
           data-controller="apple-spring">
            <i class="bi bi-eye"></i>
        </a>
        <a href="{{ path('app_paciente_edit', {'id': row.id}) }}"
           class="btn btn-outline-primary px-2"
           title="Editar Paciente"
           data-controller="apple-spring">
            <i class="bi bi-pencil"></i>
        </a>
    </div>

{% else %}
    {{ value }}
{% endif %}
