{% extends 'base.html.twig' %}

{% block title %}Configuraciones de Citas{% endblock %}

{% block titlewrap %}
    Configuraciones de Citas
{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">Configuraciones de Citas</li>
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}
    <div class="card card-primary card-outline mb-4">
        <div class="card-header">
            <h3 class="card-title">Configuraciones de Citas Registradas</h3>
        </div>

        <div class="card-body">
            <table class="table table-striped dtHere">
                <thead>
                <tr>
                    <th>Especialidad</th>
                    <th>Descripción</th>
                    <th>Pacientes Máx.</th>
                    <th>Duración Cita</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
                </thead>
                <tbody>
                {% for entity in entities %}
                    <tr class="align-middle">
                        <td>{{ entity.especialidad.nombre }}</td>
                        <td>{{ entity.descripcion|default('--') }}</td>
                        <td>{{ entity.maxPacientesDia }}</td>
                        <td>{{ entity.duracionCita }} min</td>
                        <td>
                            {% if entity.isActive %}
                                <span class="badge text-bg-success">Activo</span>
                            {% else %}
                                <span class="badge text-bg-danger">Inactivo</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <a class="btn btn-sm btn-success" href="{{ path('app_citas_configuraciones_edit', {'id': entity.id}) }}" title="Editar"><i class="bi bi-pencil-fill"></i></a>
                                
                                <!-- Toggle Button -->
                                <form method="post" action="{{ path('app_citas_configuraciones_toggle_active', {'id': entity.id}) }}" data-controller="confirm-submit" data-action="submit->confirm-submit#confirm" data-confirm-submit-title-value="{{ entity.isActive ? '¿Desactivar esta configuración?' : '¿Activar esta configuración?' }}" data-confirm-submit-text-value="{{ entity.isActive ? 'Las nuevas solicitudes de cita no la usarán.' : 'Se verificará que no exista otra configuración activa para la misma especialidad.' }}" data-confirm-submit-icon-value="{{ entity.isActive ? 'warning' : 'question' }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ entity.id) }}">
                                    <button type="submit" class="btn btn-sm btn-{{ entity.isActive ? 'warning' : 'info' }}" title="{{ entity.isActive ? 'Desactivar Configuración' : 'Activar Configuración' }}">
                                        <i class="bi bi-power"></i>
                                    </button>
                                </form>

                                <!-- Delete Button (Only visible if inactive) -->
                                {% if not entity.isActive %}
                                    <form method="post" action="{{ path('app_citas_configuraciones_delete', {'id': entity.id}) }}" data-controller="confirm-submit" data-action="submit->confirm-submit#confirm" data-confirm-submit-title-value="¿Eliminar esta configuración?" data-confirm-submit-text-value="Pasará a la papelera permanentemente." data-confirm-submit-icon-value="error" data-confirm-submit-confirm-button-text-value="Sí, Eliminar">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entity.id) }}">
                                        <button type="submit" class="btn btn-sm btn-danger" title="Eliminar Configuración"><i class="bi bi-trash-fill"></i></button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="card-footer clearfix">
            <a href="{{ path('app_citas_configuraciones_new') }}" class="btn btn-primary btn-lg"><i class="bi bi-plus-circle-fill"></i> Nuevo</a>
        </div>
    </div>
{% endblock %}
